<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>The 2020s So Far :: a vibe-check on a wild decade</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=VT323&family=Permanent+Marker&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root {
    --paper: #f4f1e8;
    --paper-2: #ebe6d6;
    --ink: #111;
    --red: #ff1f1f;
    --red-deep: #c40000;
    --yellow: #ffe600;
    --cyan: #00e0ff;
    --pink: #ff4fa3;
    --green: #1eba6a;
    --purple: #8a3ffc;
    --shadow: 6px 6px 0 var(--ink);
    --shadow-sm: 3px 3px 0 var(--ink);
  }

  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: "Bricolage Grotesque", system-ui, sans-serif;
    font-size: 18px;
    line-height: 1.65;
    overflow-x: hidden;
  }

  /* paper grain background */
  body::before {
    content: "";
    position: fixed; inset: 0;
    background-image:
      radial-gradient(circle at 12% 18%, rgba(0,0,0,.04) 0 1px, transparent 1.2px),
      radial-gradient(circle at 78% 62%, rgba(0,0,0,.035) 0 1px, transparent 1.2px),
      radial-gradient(circle at 42% 88%, rgba(0,0,0,.035) 0 1px, transparent 1.2px);
    background-size: 7px 7px, 9px 9px, 11px 11px;
    pointer-events: none;
    z-index: 0;
    opacity: .55;
  }

  /* ============ TRIGGER WARNING OVERLAY ============ */
  #tw-overlay {
    position: fixed; inset: 0;
    background: var(--ink);
    color: var(--paper);
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    text-align: center;
  }
  #tw-overlay .tw-card {
    max-width: 680px;
    background: var(--paper);
    color: var(--ink);
    border: 4px solid var(--ink);
    box-shadow: 10px 10px 0 var(--red);
    padding: 28px 28px 22px;
  }
  #tw-overlay h1 {
    font-family: "Anton", sans-serif;
    font-size: clamp(34px, 7vw, 56px);
    letter-spacing: 1px;
    margin: 0 0 10px;
    line-height: 1;
  }
  #tw-overlay .ribbon {
    display: inline-block;
    background: var(--yellow);
    border: 3px solid var(--ink);
    padding: 4px 14px;
    font-family: "Permanent Marker", cursive;
    font-size: 18px;
    transform: rotate(-2deg);
    margin-bottom: 14px;
  }
  #tw-overlay p {
    text-align: left;
    margin: 10px 0;
    font-size: 16px;
  }
  #tw-overlay ul {
    text-align: left;
    margin: 8px 0 14px;
    padding-left: 22px;
    font-size: 15px;
  }
  #tw-overlay button {
    margin-top: 10px;
    background: var(--red);
    color: white;
    font-family: "Anton", sans-serif;
    font-size: 22px;
    letter-spacing: 1.4px;
    border: 3px solid var(--ink);
    padding: 12px 22px;
    cursor: pointer;
    box-shadow: var(--shadow);
    transition: transform .12s, box-shadow .12s;
  }
  #tw-overlay button:hover {
    transform: translate(-2px,-2px);
    box-shadow: 9px 9px 0 var(--ink);
  }
  #tw-overlay button:active {
    transform: translate(3px,3px);
    box-shadow: 2px 2px 0 var(--ink);
  }
  .tw-sub {
    color: #777;
    font-size: 14px;
    margin-top: 14px;
    font-family: "Space Mono", monospace;
  }

  /* ============ PROGRESS BAR ============ */
  #progress {
    position: fixed;
    top: 0; left: 0;
    width: 0%;
    height: 6px;
    background: var(--red);
    z-index: 500;
    transition: width .1s linear;
  }

  /* ============ HERO ============ */
  .hero {
    position: relative;
    min-height: 92vh;
    padding: 90px 24px 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-bottom: 5px solid var(--ink);
  }
  .hero-bg-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(0,0,0,.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,0,0,.07) 1px, transparent 1px);
    background-size: 40px 40px;
    z-index: 0;
  }
  .hero h1 {
    font-family: "Anton", sans-serif;
    font-size: clamp(64px, 14vw, 180px);
    line-height: .85;
    margin: 0;
    text-align: center;
    letter-spacing: -1px;
    z-index: 1;
    position: relative;
  }
  .hero h1 .red { color: var(--red); }
  .hero h1 .yellow-bg {
    background: var(--yellow);
    padding: 0 10px;
    box-shadow: 4px 4px 0 var(--ink);
    display: inline-block;
    transform: rotate(-1.5deg);
  }
  .hero .sub {
    font-family: "Space Mono", monospace;
    font-size: clamp(13px, 1.6vw, 18px);
    margin-top: 28px;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--ink);
    z-index: 1;
    position: relative;
    text-align: center;
  }
  .hero .scroll-hint {
    margin-top: 36px;
    font-family: "Permanent Marker", cursive;
    font-size: 20px;
    color: var(--red);
    z-index: 1;
    position: relative;
    animation: bob 1.6s ease-in-out infinite;
  }
  @keyframes bob {
    0%,100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }

  /* floating sticker decorations on hero */
  .sticker {
    position: absolute;
    font-family: "Permanent Marker", cursive;
    padding: 6px 12px;
    border: 3px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    z-index: 2;
    font-size: 14px;
    user-select: none;
  }
  .hero .sticker.s1 { top: 12%; left: 8%; background: var(--yellow); transform: rotate(-8deg); }
  .hero .sticker.s2 { top: 18%; right: 7%; background: var(--cyan); transform: rotate(6deg); }
  .hero .sticker.s3 { bottom: 18%; left: 10%; background: var(--pink); color: white; transform: rotate(4deg); }
  .hero .sticker.s4 { bottom: 14%; right: 9%; background: var(--green); color: white; transform: rotate(-6deg); }

  @media (max-width: 700px) {
    .hero .sticker { font-size: 11px; padding: 4px 8px; }
    .hero .sticker.s1, .hero .sticker.s2 { top: 6%; }
  }

  /* ============ SECTIONS ============ */
  section.chapter {
    position: relative;
    padding: 80px 20px 90px;
    border-bottom: 5px solid var(--ink);
    z-index: 1;
  }

  .ch-inner {
    max-width: 760px;
    margin: 0 auto;
    position: relative;
  }

  .ch-tag {
    display: inline-block;
    background: var(--ink);
    color: var(--paper);
    font-family: "Space Mono", monospace;
    font-size: 13px;
    letter-spacing: 2px;
    padding: 5px 12px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .ch-tag.red { background: var(--red); }
  .ch-tag.blue { background: #0066ff; color: white; }
  .ch-tag.green { background: var(--green); color: white; }
  .ch-tag.purple { background: var(--purple); color: white; }

  .ch-num {
    font-family: "Anton", sans-serif;
    font-size: 90px;
    line-height: 1;
    color: var(--red);
    -webkit-text-stroke: 2px var(--ink);
    color: transparent;
    margin-bottom: -4px;
    user-select: none;
  }

  .ch-title {
    font-family: "Anton", sans-serif;
    font-size: clamp(40px, 7vw, 72px);
    line-height: .95;
    letter-spacing: -.5px;
    margin: 4px 0 18px;
  }

  .ch-meme {
    font-family: "Permanent Marker", cursive;
    font-size: 18px;
    color: #555;
    margin: 0 0 28px;
    transform: rotate(-.7deg);
    display: inline-block;
  }

  /* body prose */
  .prose p {
    margin: 0 0 18px;
    font-size: 18px;
    line-height: 1.7;
  }
  .prose p.lede {
    font-size: 22px;
    font-weight: 600;
    line-height: 1.5;
  }

  /* clickable vocab terms */
  .vocab {
    background: var(--yellow);
    border-bottom: 3px solid var(--ink);
    padding: 0 4px;
    cursor: pointer;
    font-weight: 700;
    position: relative;
    transition: background .15s;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .vocab::after {
    content: "?";
    font-family: "Space Mono", monospace;
    font-size: 11px;
    background: var(--ink);
    color: var(--yellow);
    border-radius: 50%;
    width: 14px; height: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: 4px;
    vertical-align: super;
    line-height: 1;
  }
  .vocab:hover { background: var(--cyan); }

  /* image cards */
  .image-card {
    margin: 32px 0;
    border: 4px solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    background: white;
    overflow: hidden;
    position: relative;
  }
  .image-card img {
    display: block;
    width: 100%;
    height: auto;
  }
  .image-card .caption {
    padding: 12px 14px;
    font-family: "Space Mono", monospace;
    font-size: 13px;
    line-height: 1.5;
    background: var(--paper-2);
    border-top: 3px solid var(--ink);
  }

  /* sensitive image wrapper */
  .sensitive-wrap {
    position: relative;
    background: var(--ink);
  }
  .sensitive-wrap img { opacity: 0; transition: opacity .3s; }
  .sensitive-wrap.shown img { opacity: 1; }
  .sensitive-cover {
    position: absolute;
    inset: 0;
    background: var(--ink);
    color: var(--paper);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    text-align: center;
    cursor: pointer;
    z-index: 2;
  }
  .sensitive-cover span.warning {
    background: var(--red);
    color: white;
    font-family: "Anton", sans-serif;
    font-size: 22px;
    padding: 4px 12px;
    letter-spacing: 1.5px;
    border: 2px solid white;
    margin-bottom: 12px;
  }
  .sensitive-cover small {
    font-family: "Space Mono", monospace;
    font-size: 12px;
    margin-top: 14px;
    opacity: .8;
  }
  .sensitive-wrap.shown .sensitive-cover { display: none; }

  /* pull quote / meme callout */
  .meme-callout {
    margin: 32px 0;
    padding: 22px 24px;
    background: var(--ink);
    color: var(--paper);
    border-left: 8px solid var(--red);
    font-family: "Anton", sans-serif;
    font-size: clamp(22px, 3.4vw, 32px);
    line-height: 1.15;
    letter-spacing: .5px;
    transform: rotate(-.4deg);
    box-shadow: 6px 6px 0 var(--red);
  }
  .meme-callout small {
    display: block;
    font-family: "Space Mono", monospace;
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--yellow);
    margin-top: 8px;
  }

  /* vibe-check / cultural moment box */
  .vibe-box {
    margin: 30px 0;
    padding: 18px 20px;
    background: var(--cyan);
    border: 3px solid var(--ink);
    box-shadow: 5px 5px 0 var(--ink);
    transform: rotate(.3deg);
    position: relative;
  }
  .vibe-box h4 {
    font-family: "Permanent Marker", cursive;
    font-size: 22px;
    margin: 0 0 6px;
    color: var(--ink);
  }
  .vibe-box h4::before {
    content: "📺 ";
  }
  .vibe-box p { margin: 0; font-size: 16px; line-height: 1.55; }
  .vibe-box.pink { background: var(--pink); color: white; }
  .vibe-box.pink h4 { color: white; }
  .vibe-box.green { background: var(--green); color: white; }
  .vibe-box.green h4 { color: white; }
  .vibe-box.yellow { background: var(--yellow); }

  /* reflect prompt */
  .reflect {
    margin: 36px 0;
    padding: 22px;
    background: var(--paper-2);
    border: 3px dashed var(--ink);
  }
  .reflect h4 {
    font-family: "Anton", sans-serif;
    font-size: 26px;
    margin: 0 0 10px;
    letter-spacing: 1px;
  }
  .reflect h4::before {
    content: "💭 PAUSE & THINK :: ";
    color: var(--red);
  }
  .reflect ol { margin: 8px 0 0; padding-left: 22px; }
  .reflect li { margin-bottom: 8px; }
  .reflect textarea {
    width: 100%;
    min-height: 70px;
    margin-top: 12px;
    border: 2px solid var(--ink);
    background: white;
    padding: 10px;
    font-family: "Bricolage Grotesque", sans-serif;
    font-size: 15px;
    resize: vertical;
  }

  /* quick check */
  .quickcheck {
    margin: 32px 0;
    padding: 22px;
    background: var(--ink);
    color: var(--paper);
    border: 3px solid var(--ink);
    box-shadow: 6px 6px 0 var(--yellow);
  }
  .quickcheck h4 {
    font-family: "Anton", sans-serif;
    font-size: 22px;
    margin: 0 0 12px;
    color: var(--yellow);
    letter-spacing: 1px;
  }
  .quickcheck h4::before { content: "⚡ QUICK CHECK :: "; }
  .quickcheck .q { margin-bottom: 14px; }
  .quickcheck .q p { margin: 0 0 8px; color: var(--paper); }
  .quickcheck .qc-opts { display: flex; flex-direction: column; gap: 6px; }
  .quickcheck .qc-opts button {
    text-align: left;
    background: var(--paper);
    color: var(--ink);
    border: 2px solid var(--paper);
    padding: 8px 12px;
    font-family: "Bricolage Grotesque", sans-serif;
    font-size: 15px;
    cursor: pointer;
    transition: transform .1s;
  }
  .quickcheck .qc-opts button:hover { transform: translateX(4px); }
  .quickcheck .qc-opts button.correct {
    background: var(--green);
    color: white;
    border-color: white;
  }
  .quickcheck .qc-opts button.wrong {
    background: var(--red);
    color: white;
    border-color: white;
  }
  .quickcheck .qc-feedback {
    margin-top: 8px;
    font-family: "Space Mono", monospace;
    font-size: 13px;
    color: var(--yellow);
    min-height: 18px;
  }

  /* ============ VOCAB MODAL ============ */
  #vocab-modal {
    position: fixed; inset: 0;
    background: rgba(0,0,0,.7);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  #vocab-modal.shown { display: flex; }
  #vocab-modal .vbox {
    max-width: 460px;
    background: var(--paper);
    border: 4px solid var(--ink);
    box-shadow: 12px 12px 0 var(--yellow);
    padding: 26px;
    position: relative;
  }
  #vocab-modal .vlabel {
    display: inline-block;
    background: var(--yellow);
    border: 2px solid var(--ink);
    padding: 2px 10px;
    font-family: "Space Mono", monospace;
    font-size: 12px;
    letter-spacing: 2px;
    margin-bottom: 10px;
  }
  #vocab-modal h3 {
    font-family: "Anton", sans-serif;
    font-size: 38px;
    margin: 4px 0 14px;
    letter-spacing: 1px;
    line-height: 1;
  }
  #vocab-modal p { margin: 0; font-size: 16px; line-height: 1.6; }
  #vocab-modal .closer {
    position: absolute;
    top: -16px; right: -16px;
    width: 40px; height: 40px;
    background: var(--red);
    color: white;
    border: 3px solid var(--ink);
    border-radius: 50%;
    font-size: 22px;
    cursor: pointer;
    font-family: "Anton", sans-serif;
  }

  /* ============ QUIZ ============ */
  section#quiz {
    background: var(--ink);
    color: var(--paper);
    padding: 80px 20px 90px;
  }
  #quiz .ch-inner { max-width: 820px; }
  #quiz h2 {
    font-family: "Anton", sans-serif;
    font-size: clamp(56px, 11vw, 110px);
    line-height: .9;
    margin: 0 0 8px;
    color: var(--paper);
    text-align: center;
  }
  #quiz h2 .yel { color: var(--yellow); }
  #quiz .quiz-intro {
    text-align: center;
    margin-bottom: 40px;
    font-family: "Space Mono", monospace;
    font-size: 15px;
    color: #c8c2a8;
  }
  #quiz .qblock {
    margin: 38px 0;
    padding: 24px;
    background: #1c1c1c;
    border: 2px solid var(--paper);
    border-left: 8px solid var(--yellow);
  }
  #quiz .qblock h3 {
    font-family: "Anton", sans-serif;
    font-size: 30px;
    margin: 0 0 18px;
    letter-spacing: 1px;
    color: var(--yellow);
  }
  #quiz .qblock h3 .hint {
    font-family: "Space Mono", monospace;
    font-size: 12px;
    color: #999;
    letter-spacing: 1px;
    margin-left: 6px;
  }

  .quiz-q {
    margin: 14px 0 20px;
    border-bottom: 1px dashed #444;
    padding-bottom: 16px;
  }
  .quiz-q:last-child { border-bottom: none; }
  .quiz-q .qtext {
    margin: 0 0 10px;
    line-height: 1.5;
    font-size: 16px;
  }
  .quiz-q .qtext strong { color: var(--cyan); }

  .quiz-q input[type=text] {
    background: #2a2a2a;
    border: 2px solid #555;
    color: var(--paper);
    padding: 6px 10px;
    font-family: "Space Mono", monospace;
    font-size: 15px;
    min-width: 200px;
  }
  .quiz-q input[type=text]:focus {
    outline: none;
    border-color: var(--yellow);
  }

  .tf-buttons, .mc-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tf-buttons button, .mc-buttons button {
    background: #2a2a2a;
    color: var(--paper);
    border: 2px solid #555;
    padding: 8px 14px;
    cursor: pointer;
    font-family: "Bricolage Grotesque", sans-serif;
    font-size: 15px;
    text-align: left;
    transition: all .15s;
  }
  .mc-buttons { flex-direction: column; align-items: stretch; }
  .tf-buttons button:hover, .mc-buttons button:hover {
    border-color: var(--yellow);
    background: #333;
  }
  .quiz-q.answered .tf-buttons button,
  .quiz-q.answered .mc-buttons button {
    cursor: default;
  }
  .quiz-q .selected-correct { background: var(--green) !important; border-color: white !important; }
  .quiz-q .selected-wrong { background: var(--red) !important; border-color: white !important; }
  .quiz-q .show-correct { border-color: var(--green) !important; border-width: 3px !important; }

  .qfb {
    font-family: "Space Mono", monospace;
    font-size: 13px;
    color: var(--yellow);
    margin-top: 8px;
    min-height: 16px;
  }

  /* matching */
  .match-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 600px) {
    .match-wrap { grid-template-columns: 1fr; }
  }
  .match-col h4 {
    font-family: "Anton", sans-serif;
    color: var(--yellow);
    margin: 0 0 10px;
    letter-spacing: 1px;
    font-size: 18px;
  }
  .match-item, .match-target {
    background: #2a2a2a;
    border: 2px solid #555;
    padding: 8px 12px;
    margin-bottom: 8px;
    border-radius: 4px;
    font-size: 14px;
    line-height: 1.4;
  }
  .match-item { cursor: pointer; }
  .match-item.selected { border-color: var(--cyan); background: #1a3340; }
  .match-item.matched { opacity: .55; cursor: default; }
  .match-target {
    cursor: pointer;
    position: relative;
  }
  .match-target.has-match {
    border-color: var(--green);
    background: #1a3320;
  }
  .match-target .placed {
    margin-top: 6px;
    font-family: "Space Mono", monospace;
    font-size: 12px;
    color: var(--cyan);
  }
  .match-target.show-wrong { border-color: var(--red); }
  .match-target.show-right { border-color: var(--green); }

  /* essay */
  .essay-prompt {
    margin: 14px 0;
    font-size: 16px;
    line-height: 1.6;
  }
  .essay-prompt textarea {
    width: 100%;
    min-height: 180px;
    background: #2a2a2a;
    color: var(--paper);
    border: 2px solid #555;
    padding: 12px;
    font-family: "Bricolage Grotesque", sans-serif;
    font-size: 15px;
    resize: vertical;
  }
  .essay-prompt textarea:focus { outline: none; border-color: var(--yellow); }
  .word-count {
    font-family: "Space Mono", monospace;
    font-size: 12px;
    color: #aaa;
    margin-top: 6px;
  }

  /* score box */
  #score-display {
    margin: 40px auto 0;
    text-align: center;
    padding: 30px;
    background: var(--yellow);
    color: var(--ink);
    border: 4px solid var(--paper);
    box-shadow: 10px 10px 0 var(--red);
    display: none;
  }
  #score-display.shown { display: block; }
  #score-display h3 {
    font-family: "Anton", sans-serif;
    font-size: 60px;
    margin: 0 0 6px;
    letter-spacing: 1px;
  }
  #score-display .scoreline {
    font-family: "Space Mono", monospace;
    font-size: 18px;
  }
  #score-display .gif {
    font-family: "Permanent Marker", cursive;
    font-size: 24px;
    color: var(--red);
    margin-top: 8px;
  }

  .quiz-submit {
    display: block;
    margin: 40px auto 0;
    background: var(--red);
    color: white;
    font-family: "Anton", sans-serif;
    font-size: 32px;
    letter-spacing: 2px;
    border: 3px solid var(--paper);
    padding: 18px 36px;
    cursor: pointer;
