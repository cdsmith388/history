          <div class="match-target" data-match="dobbs">2022 Supreme Court case that overturned Roe v. Wade.</div>
          <div class="match-target" data-match="brexit">Nickname for the United Kingdom leaving the European Union.</div>
          <div class="match-target" data-match="chatgpt">OpenAI's chatbot, released in November 2022, hit 100 million users in 2 months.</div>
          <div class="match-target" data-match="oct7">Date Hamas-led groups attacked Israel, starting the Gaza war.</div>
          <div class="match-target" data-match="harris">Lost the 2024 presidential election after Biden withdrew.</div>
        </div>
      </div>
    </div>

    <!-- ESSAY -->
    <div class="qblock">
      <h3>PART 5 :: ESSAY <span class="hint">your turn</span></h3>
      <div class="essay-prompt">
        <p style="margin: 0 0 14px; line-height: 1.6;">The text says the central conflict of the 2020s so far is that "people are more connected, more watched, more informed, more misinformed, more entertained, and more distrustful than ever."</p>
        <p style="margin: 0 0 14px; line-height: 1.6;"><strong style="color: var(--cyan);">In 200-300 words</strong>, pick one event from this lesson (the pandemic, the protests after George Floyd, the January 6 attack, Brexit, the Dobbs decision, the war in Ukraine, the war in Gaza, the rise of AI, or Trump's return in 2024). Explain how that event shows the tension between being "more connected" and being "more distrustful" at the same time. Use details from the lesson and one example from your own life or the world around you.</p>
        <textarea id="essay-input" placeholder="start typing your essay here... no pressure. just think honestly about what you noticed."></textarea>
        <div class="word-count" id="word-count">0 words</div>
      </div>
    </div>

    <button class="quiz-submit" onclick="gradeQuiz()">CHECK MY ANSWERS →</button>

    <div id="score-display">
      <h3 id="score-num">0 / 25</h3>
      <div class="scoreline" id="score-line">// nice work</div>
      <div class="gif" id="score-emoji">↑ you scrolled through a wild decade ↑</div>
    </div>

  </div>
</section>

<!-- ============ FOOTER ============ -->
<footer class="foot">
  <h3>U JUST FINISHED THE 2020s</h3>
  <p>// the decade isn't over yet :: what happens next is partly up to you</p>
  <p style="margin-top: 18px;">scroll back up to revisit any chapter →</p>
</footer>

<!-- ============ VOCAB MODAL ============ -->
<div id="vocab-modal" onclick="if(event.target.id==='vocab-modal')closeVocab()">
  <div class="vbox">
    <button class="closer" onclick="closeVocab()">×</button>
    <span class="vlabel">// VOCAB</span>
    <h3 id="vocab-term">term</h3>
    <p id="vocab-def">definition</p>
  </div>
</div>

<script>
const IMG = {
  covid_virus: "data:image/jpeg;base64,",
  mass_graves: "data:image/jpeg;base64,",
  social_distance_circles: "data:image/jpeg;base64,",
  empty_times_square: "data:image/jpeg;base64,",
  first_vaccine: "data:image/jpeg;base64,",
  memorial_wall: "data:image/jpeg;base64,",
  floyd_protest: "data:image/jpeg;base64,",
  burning_car: "data:image/jpeg;base64,",
  biden: "data:image/jpeg;base64,",
  jan6: "data:image/jpeg;base64,",
  brexit: "data:image/jpeg;base64,",
  ukraine_map: "data:image/jpeg;base64,",
  ukraine_tanks: "data:image/jpeg;base64,",
  gaza_smoke: "data:image/jpeg;base64,",
  israel_running: "data:image/jpeg;base64,",
  chatgpt: "data:image/jpeg;base64,",
  algorithm_diagram: "data:image/jpeg;base64,",
  neural_network: "data:image/jpeg;base64,",
  trump_rally: "data:image/jpeg;base64,",
};

// ============ VOCAB DEFINITIONS ============
const VOCAB = {
  covid19: { term: "COVID-19", def: "A respiratory disease caused by the SARS-CoV-2 virus, which spread worldwide starting in late 2019. 'CO' stands for corona, 'VI' for virus, 'D' for disease, and '19' for 2019, the year it was first identified." },
  quarantine: { term: "Quarantine", def: "Staying separated from other people if you may have been exposed to a contagious disease, to stop the disease from spreading. During COVID, many people quarantined at home for 5 to 14 days after exposure." },
  lockdown: { term: "Lockdown", def: "An emergency order keeping people in their homes and shutting down most businesses, schools, and gatherings to slow the spread of disease. Most countries had at least one lockdown in 2020." },
  pandemic: { term: "Pandemic", def: "An outbreak of disease that spreads across multiple countries or continents and affects a huge number of people. An epidemic is contained in one region; a pandemic is everywhere." },
  mrna: { term: "mRNA Vaccine", def: "A vaccine that uses messenger RNA, a tiny instruction sheet, to teach your cells how to build a harmless piece of a virus. Your immune system practices on that piece. mRNA vaccines do NOT contain the live virus and do NOT change your DNA." },
  remote_work: { term: "Remote Work", def: "Doing your job from somewhere other than the office, usually from home, using video calls, email, and chat. Remote work became common in 2020 because so many offices closed during the pandemic." },
  electoral_college: { term: "Electoral College", def: "The system the U.S. uses to elect the president. Voters in each state pick electors, and those electors cast 538 total votes. A candidate needs 270 electoral votes to win. It is not the same as the national popular vote." },
  transfer_of_power: { term: "Transfer of Power", def: "When one government peacefully hands control over to the next one after an election. The U.S. had done this every four years since 1789. January 6, 2021 was the first time a mob seriously tried to stop it." },
  referendum: { term: "Referendum", def: "A direct vote by the people on one specific question, usually a big political decision. The 2016 Brexit referendum asked British voters: should the UK stay in the European Union, or leave?" },
  roe: { term: "Roe v. Wade", def: "A 1973 U.S. Supreme Court case that said the Constitution protected a right to abortion. The 2022 Dobbs decision overturned Roe and sent the question back to the states." },
  nato: { term: "NATO", def: "The North Atlantic Treaty Organization. A military alliance of the U.S., Canada, and many European countries. If one NATO member is attacked, the others are pledged to defend them. NATO grew during the 2020s because of the war in Ukraine." },
  humanitarian: { term: "Humanitarian", def: "Anything to do with saving human lives and reducing suffering. A 'humanitarian crisis' is a situation, often during war or disaster, where many people lack food, water, shelter, or safety." },
  semiconductors: { term: "Semiconductors", def: "Tiny chips made of materials like silicon that power almost every modern device. Phones, cars, fridges, fighter jets, and AI all need them. Who makes the most advanced semiconductors is a huge deal in the U.S.-China rivalry." },
  algorithm: { term: "Algorithm", def: "A step-by-step set of rules a computer follows to turn input into output. Your TikTok 'For You' feed uses an algorithm to predict what you'll watch next. Algorithms can be helpful, but they also shape what people see and believe." },
  generative_ai: { term: "Generative AI", def: "Artificial intelligence that creates new content like words, images, code, or sound, based on patterns it learned from huge amounts of data. ChatGPT, image generators, and AI music tools are all generative AI." },
  neural_network: { term: "Neural Network", def: "A computer system loosely inspired by how brain cells connect. Data goes in one side, passes through layers of math, and a prediction comes out the other side. Modern AI like ChatGPT runs on enormous neural networks." }
};

function openVocab(term) {
  const v = VOCAB[term];
  if (!v) return;
  document.getElementById('vocab-term').textContent = v.term;
  document.getElementById('vocab-def').textContent = v.def;
  document.getElementById('vocab-modal').classList.add('shown');
}
function closeVocab() {
  document.getElementById('vocab-modal').classList.remove('shown');
}
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') closeVocab();
});

// ============ IMAGE LOADING ============
document.querySelectorAll('img[data-img]').forEach(img => {
  const key = img.getAttribute('data-img');
  if (IMG[key]) img.src = IMG[key];
});

// ============ VOCAB CLICK BINDING ============
document.querySelectorAll('.vocab').forEach(el => {
  el.addEventListener('click', () => openVocab(el.dataset.term));
});

// ============ SENSITIVE IMAGE REVEAL ============
document.querySelectorAll('[data-sensitive]').forEach(wrap => {
  wrap.querySelector('.sensitive-cover').addEventListener('click', () => {
    wrap.classList.add('shown');
  });
});

// ============ QUICK CHECK BUTTONS ============
document.querySelectorAll('.quickcheck .q').forEach(q => {
  const data = JSON.parse(q.dataset.qc);
  const opts = q.querySelectorAll('.qc-opts button');
  const fb = q.querySelector('.qc-feedback');
  opts.forEach((b, i) => {
    b.addEventListener('click', () => {
      if (q.classList.contains('done')) return;
      opts.forEach(x => x.disabled = true);
      if (i === data.correct) {
        b.classList.add('correct');
        fb.textContent = '✓ ' + data.feedback;
      } else {
        b.classList.add('wrong');
        opts[data.correct].classList.add('correct');
        fb.textContent = '↻ ' + data.feedback;
      }
      q.classList.add('done');
    });
  });
});

// ============ PROGRESS BAR ============
const progress = document.getElementById('progress');
function updateProgress() {
  const scrolled = window.scrollY;
  const max = document.body.scrollHeight - window.innerHeight;
  progress.style.width = (scrolled / max * 100) + '%';
}
window.addEventListener('scroll', updateProgress);

// ============ REVEAL ON SCROLL ============
// Content visible by default. We add `.pre` to enable hidden state, then `.in` when it scrolls into view.
const revealEls = document.querySelectorAll('.reveal');
revealEls.forEach(el => el.classList.add('pre'));
const revealObserver = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.classList.add('in');
      revealObserver.unobserve(e.target);
    }
  });
}, { threshold: 0, rootMargin: '0px 0px -50px 0px' });
revealEls.forEach(el => revealObserver.observe(el));
// Safety net: in case the observer hiccups, force-reveal everything after 2.5s
setTimeout(() => {
  document.querySelectorAll('.reveal:not(.in)').forEach(el => el.classList.add('in'));
}, 2500);

// ============ QUIZ ============
// Fill in the blank
document.querySelectorAll('.quiz-q[data-fill]').forEach(q => {
  const valid = JSON.parse(q.dataset.fill).map(s => s.toLowerCase().trim());
  const input = q.querySelector('input');
  const fb = q.querySelector('.qfb');
  input.addEventListener('blur', () => {
    const v = input.value.toLowerCase().trim();
    if (!v) { fb.textContent = ''; q.dataset.correct = ''; return; }
    if (valid.includes(v)) {
      fb.textContent = '✓ nailed it';
      fb.style.color = '#1eba6a';
      q.dataset.correct = 'true';
    } else {
      fb.textContent = '↻ not quite, but keep going';
      fb.style.color = '#ff8080';
      q.dataset.correct = 'false';
    }
  });
});

// True / False
document.querySelectorAll('.quiz-q[data-tf]').forEach(q => {
  const correct = q.dataset.tf;
  const fb = q.querySelector('.qfb');
  q.querySelectorAll('.tf-buttons button').forEach(b => {
    b.addEventListener('click', () => {
      if (q.classList.contains('answered')) return;
      q.classList.add('answered');
      const isRight = b.dataset.val === correct;
      if (isRight) {
        b.classList.add('selected-correct');
        fb.textContent = '✓ correct';
        fb.style.color = '#1eba6a';
        q.dataset.score = '1';
      } else {
        b.classList.add('selected-wrong');
        q.querySelectorAll('button').forEach(x => { if (x.dataset.val === correct) x.classList.add('show-correct'); });
        fb.textContent = '↻ actually: ' + correct.toUpperCase();
        fb.style.color = '#ff8080';
        q.dataset.score = '0';
      }
    });
  });
});

// Multiple choice
document.querySelectorAll('.quiz-q[data-mc]').forEach(q => {
  const correct = parseInt(q.dataset.mc, 10);
  const fb = q.querySelector('.qfb');
  q.querySelectorAll('.mc-buttons button').forEach((b) => {
    b.addEventListener('click', () => {
      if (q.classList.contains('answered')) return;
      q.classList.add('answered');
      const picked = parseInt(b.dataset.val, 10);
      if (picked === correct) {
        b.classList.add('selected-correct');
        fb.textContent = '✓ correct';
        fb.style.color = '#1eba6a';
        q.dataset.score = '1';
      } else {
        b.classList.add('selected-wrong');
        q.querySelectorAll('button').forEach(x => { if (parseInt(x.dataset.val, 10) === correct) x.classList.add('show-correct'); });
        fb.textContent = '↻ check the highlighted answer';
        fb.style.color = '#ff8080';
        q.dataset.score = '0';
      }
    });
  });
});

// Matching
let matchSelection = null;
const matchState = {};
document.querySelectorAll('.match-item').forEach(item => {
  item.addEventListener('click', () => {
    if (item.classList.contains('matched')) return;
    if (matchSelection === item) {
      item.classList.remove('selected');
      matchSelection = null;
    } else {
      document.querySelectorAll('.match-item').forEach(x => x.classList.remove('selected'));
      item.classList.add('selected');
      matchSelection = item;
    }
  });
});
document.querySelectorAll('.match-target').forEach(t => {
  t.addEventListener('click', () => {
    if (!matchSelection) return;
    const key = matchSelection.dataset.key;
    const expected = t.dataset.match;
    matchState[key] = expected;

    // Place visual
    let placed = t.querySelector('.placed');
    if (!placed) {
      placed = document.createElement('div');
      placed.className = 'placed';
      t.appendChild(placed);
    }
    placed.textContent = '→ matched: ' + matchSelection.textContent;
    t.classList.add('has-match');
    matchSelection.classList.add('matched');
    matchSelection.classList.remove('selected');
    matchSelection = null;
  });
});

// Word count for essay
const essayInput = document.getElementById('essay-input');
const wc = document.getElementById('word-count');
essayInput.addEventListener('input', () => {
  const words = essayInput.value.trim().split(/\s+/).filter(Boolean).length;
  wc.textContent = words + ' word' + (words === 1 ? '' : 's');
  if (words >= 200 && words <= 300) wc.style.color = '#1eba6a';
  else if (words > 300) wc.style.color = '#ffe600';
  else wc.style.color = '#aaa';
});

// Grade quiz
function gradeQuiz() {
  let score = 0;
  let totalAuto = 0;

  // fill
  document.querySelectorAll('.quiz-q[data-fill]').forEach(q => {
    totalAuto++;
    if (q.dataset.correct === 'true') score++;
    else {
      const valid = JSON.parse(q.dataset.fill)[0];
      const fb = q.querySelector('.qfb');
      if (!fb.textContent || fb.textContent.startsWith('↻') || !q.dataset.correct) {
        fb.textContent = '↻ the answer was: ' + valid;
        fb.style.color = '#ff8080';
      }
    }
  });

  // tf
  document.querySelectorAll('.quiz-q[data-tf]').forEach(q => {
    totalAuto++;
    if (q.dataset.score === '1') score++;
    else if (!q.classList.contains('answered')) {
      const fb = q.querySelector('.qfb');
      fb.textContent = '↻ skipped :: answer was ' + q.dataset.tf.toUpperCase();
      fb.style.color = '#ff8080';
    }
  });

  // mc
  document.querySelectorAll('.quiz-q[data-mc]').forEach(q => {
    totalAuto++;
    if (q.dataset.score === '1') score++;
    else if (!q.classList.contains('answered')) {
      const correct = parseInt(q.dataset.mc, 10);
      q.querySelectorAll('button').forEach(b => {
        if (parseInt(b.dataset.val, 10) === correct) b.classList.add('show-correct');
      });
      q.querySelector('.qfb').textContent = '↻ skipped :: highlighted option was correct';
      q.querySelector('.qfb').style.color = '#ff8080';
    }
  });

  // matching: count matches correctly placed
  const matchTotal = document.querySelectorAll('.match-target').length;
  let matchScore = 0;
  document.querySelectorAll('.match-target').forEach(t => {
    const expected = t.dataset.match;
    if (matchState[expected] === expected) {
      matchScore++;
      t.classList.add('show-right');
    } else if (t.classList.contains('has-match')) {
      t.classList.add('show-wrong');
    }
  });

  totalAuto += matchTotal;
  score += matchScore;

  // essay
  const essayWords = essayInput.value.trim().split(/\s+/).filter(Boolean).length;
  let essayMsg = '';
  if (essayWords === 0) essayMsg = '// no essay yet :: graded by your teacher';
  else if (essayWords < 200) essayMsg = '// essay too short (need 200-300 words) :: teacher grades the rest';
  else if (essayWords > 320) essayMsg = '// essay over 300 words :: teacher reviews it';
  else essayMsg = '// essay within the right length :: teacher reads it for the final mark';

  const display = document.getElementById('score-display');
  document.getElementById('score-num').textContent = score + ' / ' + totalAuto;
  document.getElementById('score-line').textContent = essayMsg;

  let emoji;
  const pct = score / totalAuto;
  if (pct >= 0.9) emoji = '🏆 you absolutely cooked';
  else if (pct >= 0.75) emoji = '🔥 solid run';
  else if (pct >= 0.5) emoji = '📚 not bad, scroll back up to review';
  else emoji = '↻ rewatch the lesson, you got this';
  document.getElementById('score-emoji').textContent = emoji;

  display.classList.add('shown');
  display.scrollIntoView({ behavior: 'smooth', block: 'center' });
}
window.gradeQuiz = gradeQuiz;

// Disable body scroll while overlay is up
document.body.style.overflow = 'hidden';

// Start with progress at 0
updateProgress();
</script>

