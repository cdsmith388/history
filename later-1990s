// Build clickable handlers
document.querySelectorAll('.term').forEach(el => {
  el.addEventListener('click', () => {
    const key = el.dataset.term;
    const def = definitions[key];
    if (!def) return;
    document.getElementById('defTerm').textContent = key;
    document.getElementById('defText').textContent = def;
    document.getElementById('defOverlay').classList.add('active');
  });
});
function closeDef() {
  document.getElementById('defOverlay').classList.remove('active');
}
document.getElementById('defOverlay').addEventListener('click', e => {
  if (e.target.id === 'defOverlay') closeDef();
});
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDef(); });

// ----------------------------------------------
// REVEAL ON SCROLL
// ----------------------------------------------
const io = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
}, { threshold: 0.12 });
document.querySelectorAll('.reveal').forEach(el => io.observe(el));

// ----------------------------------------------
// TRUE/FALSE BUTTONS
// ----------------------------------------------
const tfState = {};
document.querySelectorAll('.tf-buttons').forEach(group => {
  group.querySelectorAll('button').forEach(btn => {
    btn.addEventListener('click', () => {
      const idx = group.dataset.tf;
      tfState[idx] = btn.dataset.val;
      group.querySelectorAll('button').forEach(b => b.classList.remove('selected', 'correct', 'wrong'));
      btn.classList.add('selected');
    });
  });
});

// ----------------------------------------------
// MATCHING SETUP
// ----------------------------------------------
const matchPairs = [
  { left: "Maastricht Treaty enters into force", right: "November 1, 1993" },
  { left: "Nintendo 64 launches in North America", right: "September 29, 1996" },
  { left: "DVD video launches in the United States", right: "1997" },
  { left: "AOL Instant Messenger (AIM) launches", right: "1997" },
  { left: "U.S. embassy bombings in East Africa", right: "August 7, 1998" },
  { left: "House of Representatives impeaches Clinton", right: "December 1998" },
  { left: "Euro launches as electronic currency", right: "January 1, 1999" },
  { left: "Columbine High School shooting", right: "April 20, 1999" }
];

// Shuffle the right-side options once for the dropdown
function shuffle(arr) {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
const shuffledRights = shuffle(matchPairs.map(p => p.right));
// Deduplicate display but keep duplicates so user can pick either one
const matchOptions = shuffledRights;

const matchGrid = document.getElementById('matchGrid');
matchPairs.forEach((pair, idx) => {
  const row = document.createElement('div');
  row.className = 'match-row';
  row.dataset.match = idx;
  row.dataset.answer = pair.right;
  row.innerHTML = `
    <div class="left"><span class="q-num">${idx + 1}.</span> ${pair.left}</div>
    <div class="arrow">→</div>
    <select data-match-select="${idx}">
      <option value="">-- pick a year --</option>
      ${matchOptions.map(r => `<option value="${r}">${r}</option>`).join('')}
    </select>
  `;
  matchGrid.appendChild(row);
});

// ----------------------------------------------
// ESSAY WORD COUNT
// ----------------------------------------------
const essayText = document.getElementById('essayText');
const wcEl = document.getElementById('wc');
essayText.addEventListener('input', () => {
  const words = essayText.value.trim().split(/\s+/).filter(Boolean).length;
  wcEl.textContent = words;
});

// ----------------------------------------------
// GRADE QUIZ
// ----------------------------------------------
function normalize(s) {
  return s.toLowerCase().trim().replace(/[\.,\!\?\;\:]/g, '');
}

function gradeQuiz() {
  let fibCorrect = 0;
  let tfCorrect = 0;
  let mcCorrect = 0;
  let matchCorrect = 0;

  // FIB
  document.querySelectorAll('[data-fib]').forEach(input => {
    const ans = input.dataset.answer.toLowerCase();
    const val = normalize(input.value);
    input.style.borderBottomColor = '';
    if (!val) {
      input.style.borderBottomColor = 'var(--paper-stain)';
      return;
    }
    // Allow "sergey brin" or just "brin"; for "y2k" also accept "y2k bug" etc.
    const accepted = {
      "sergey brin": ["sergey brin", "brin", "sergey"],
      "1999": ["1999"],
      "maastricht": ["maastricht"],
      "hillenburg": ["hillenburg", "stephen hillenburg"],
      "y2k": ["y2k", "y2k bug", "y 2 k", "y2 k"]
    };
    const ok = (accepted[ans] || [ans]).some(a => val === a);
    if (ok) {
      fibCorrect++;
      input.style.borderBottomColor = 'var(--crt-green)';
      input.style.color = 'var(--crt-green)';
    } else {
      input.style.borderBottomColor = 'var(--oxblood)';
      input.style.color = 'var(--oxblood)';
      input.title = 'Correct answer: ' + ans;
    }
  });

  // T/F
  document.querySelectorAll('.tf-buttons').forEach(group => {
    const idx = group.dataset.tf;
    const ans = group.dataset.answer;
    const chosen = tfState[idx];
    group.querySelectorAll('button').forEach(b => b.classList.remove('correct', 'wrong'));
    if (!chosen) return;
    if (chosen === ans) {
      tfCorrect++;
      group.querySelector(`button[data-val="${chosen}"]`).classList.add('correct');
    } else {
      group.querySelector(`button[data-val="${chosen}"]`).classList.add('wrong');
      group.querySelector(`button[data-val="${ans}"]`).classList.add('correct');
    }
  });

  // MC
  document.querySelectorAll('[data-mc]').forEach(group => {
    const idx = group.dataset.mc;
    const ans = group.dataset.answer;
    const chosen = group.querySelector('input[type="radio"]:checked');
    group.querySelectorAll('label').forEach(l => l.classList.remove('correct', 'wrong'));
    if (!chosen) return;
    const chosenLabel = chosen.closest('label');
    const correctLabel = group.querySelector(`input[value="${ans}"]`).closest('label');
    if (chosen.value === ans) {
      mcCorrect++;
      chosenLabel.classList.add('correct');
    } else {
      chosenLabel.classList.add('wrong');
      correctLabel.classList.add('correct');
    }
  });

  // Matching
  document.querySelectorAll('.match-row').forEach(row => {
    const ans = row.dataset.answer;
    const sel = row.querySelector('select');
    row.classList.remove('correct', 'wrong');
    if (!sel.value) return;
    if (sel.value === ans) {
      matchCorrect++;
      row.classList.add('correct');
    } else {
      row.classList.add('wrong');
    }
  });

  const totals = { fib: 5, tf: 10, mc: 10, match: 8 };
  const got = fibCorrect + tfCorrect + mcCorrect + matchCorrect;
  const max = totals.fib + totals.tf + totals.mc + totals.match; // 33
  const pct = Math.round((got / max) * 100);

  document.getElementById('scoreNum').textContent = `${got} / ${max}`;
  document.getElementById('scorePct').textContent = `${pct}%`;

  let label = '';
  if (pct >= 90) label = '★ Encore performance ★';
  else if (pct >= 80) label = 'Solid set';
  else if (pct >= 70) label = 'Decent show, a few flat notes';
  else if (pct >= 60) label = 'Needs another rehearsal';
  else label = 'Hit rewind and try again';
  document.getElementById('gradeLabel').textContent = label;

  document.getElementById('breakdown').innerHTML = `
    <div><span>Fill in the Blanks</span><span>${fibCorrect} / ${totals.fib}</span></div>
    <div><span>True / False</span><span>${tfCorrect} / ${totals.tf}</span></div>
    <div><span>Multiple Choice</span><span>${mcCorrect} / ${totals.mc}</span></div>
    <div><span>Matching</span><span>${matchCorrect} / ${totals.match}</span></div>
    <div><span>Essay</span><span>graded by hand</span></div>
  `;

  document.getElementById('results').classList.add('show');
  document.getElementById('results').scrollIntoView({ behavior: 'smooth', block: 'center' });
}

function resetQuiz() {
  document.querySelectorAll('[data-fib]').forEach(input => {
    input.value = '';
    input.style.borderBottomColor = '';
    input.style.color = '';
    input.title = '';
  });
  document.querySelectorAll('.tf-buttons').forEach(g => {
    g.querySelectorAll('button').forEach(b => b.classList.remove('selected', 'correct', 'wrong'));
  });
  for (const k in tfState) delete tfState[k];
  document.querySelectorAll('[data-mc]').forEach(g => {
    g.querySelectorAll('input[type="radio"]').forEach(r => r.checked = false);
    g.querySelectorAll('label').forEach(l => l.classList.remove('correct', 'wrong'));
  });
  document.querySelectorAll('.match-row').forEach(r => {
    r.querySelector('select').value = '';
    r.classList.remove('correct', 'wrong');
  });
  essayText.value = '';
  wcEl.textContent = '0';
  document.getElementById('results').classList.remove('show');
  window.scrollTo({ top: document.getElementById('quiz').offsetTop, behavior: 'smooth' });
}
</script>

