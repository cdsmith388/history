function getAudio() {
  if (!audioCtx) {
    try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
    catch (e) { return null; }
  }
  return audioCtx;
}

function blip(freq = 440, duration = 0.04, type = "square", vol = 0.06) {
  if (muted) return;
  const ctx = getAudio();
  if (!ctx) return;
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();
  osc.type = type;
  osc.frequency.value = freq;
  gain.gain.value = vol;
  gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
  osc.connect(gain);
  gain.connect(ctx.destination);
  osc.start();
  osc.stop(ctx.currentTime + duration);
}

function chime() {
  if (muted) return;
  blip(523, 0.1, "square", 0.08);
  setTimeout(() => blip(659, 0.1, "square", 0.08), 90);
  setTimeout(() => blip(784, 0.18, "square", 0.08), 180);
}

function buzz() {
  if (muted) return;
  blip(220, 0.18, "sawtooth", 0.06);
}

function pop() {
  if (muted) return;
