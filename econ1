        body += `<button class="q-opt" data-val="${i}"><strong>${String.fromCharCode(65 + i)}.</strong> ${opt}</button>`;
      });
      body += `</div>`;
    } else if (q.type === "fib") {
      body += `<div class="q-fib-row">
        <input class="q-fib-input" type="text" placeholder="Type your answer here..." autocomplete="off">
        <button class="q-check-btn">Check ✓</button>
      </div>`;
    } else if (q.type === "match") {
      const defs = q.pairs.map(p => p.def);
      const shuffled = [...defs].sort(() => Math.random() - 0.5);
      body += `<div class="q-match-grid">`;
      q.pairs.forEach((p, i) => {
        body += `<div class="term">${String.fromCharCode(65 + i)}. ${p.term}</div>
          <select class="q-match-select" data-correct="${defs.indexOf(p.def)}" data-idx="${i}">
            <option value="">, pick a definition ,</option>`;
        shuffled.forEach(d => {
          body += `<option value="${defs.indexOf(d)}">${d}</option>`;
        });
        body += `</select>`;
      });
      body += `</div>
        <button class="q-check-btn" style="margin-top:12px;">Check All ✓</button>`;
    }

    body += `<div class="q-feedback"></div>`;

    card.innerHTML = body;
    quizArea.appendChild(card);
    sectionObserver.observe(card);

    /* Wire up the question */
    const feedback = card.querySelector(".q-feedback");

    if (q.type === "tf" || q.type === "mc") {
      card.querySelectorAll(".q-opt").forEach(opt => {
        opt.addEventListener("click", () => {
          if (opt.disabled) return;
          card.querySelectorAll(".q-opt").forEach(o => o.disabled = true);

          let correct = false;
          if (q.type === "tf") {
            correct = (opt.dataset.val === String(q.answer));
          } else {
            correct = (parseInt(opt.dataset.val) === q.answer);
          }

          if (correct) {
            opt.classList.add("correct");
            feedback.textContent = "✓ Correct! " + q.explain + " +100 bells!";
            feedback.className = "q-feedback show good";
            chime();
            awardBells(100, opt);
          } else {
            opt.classList.add("wrong");
            card.querySelectorAll(".q-opt").forEach(o => {
              const isAns = q.type === "tf"
                ? (o.dataset.val === String(q.answer))
                : (parseInt(o.dataset.val) === q.answer);
              if (isAns) o.classList.add("correct");
            });
            feedback.textContent = "✗ Not quite. " + q.explain;
            feedback.className = "q-feedback show bad";
            buzz();
          }
          quizAnswered(idx, correct);
        });
      });
    } else if (q.type === "fib") {
      const input = card.querySelector(".q-fib-input");
      const btn = card.querySelector(".q-check-btn");
      const check = () => {
        if (btn.disabled) return;
        const ans = input.value.trim().toLowerCase().replace(/[^a-z ]/g, "").replace(/\s+/g, " ").trim();
        if (!ans) return;
        const correct = q.answers.some(a => {
          const clean = a.toLowerCase().replace(/[^a-z ]/g, "").replace(/\s+/g, " ").trim();
          return clean === ans || (clean.length > 4 && ans.includes(clean)) || (ans.length > 4 && clean.includes(ans));
        });
        btn.disabled = true;
        input.disabled = true;
        if (correct) {
          input.style.background = "var(--leaf)";
          input.style.color = "white";
          feedback.textContent = "✓ Yes yes! " + q.explain + " +100 bells!";
          feedback.className = "q-feedback show good";
          chime();
          awardBells(100, input);
        } else {
          input.style.background = "#f0a4ad";
          input.style.color = "white";
          feedback.textContent = "✗ Not quite. The answer was: " + q.answers[0] + ". " + q.explain;
          feedback.className = "q-feedback show bad";
          buzz();
        }
        quizAnswered(idx, correct);
      };
      btn.addEventListener("click", check);
      input.addEventListener("keydown", (e) => { if (e.key === "Enter") check(); });
    } else if (q.type === "match") {
      const btn = card.querySelector(".q-check-btn");
      btn.addEventListener("click", () => {
        if (btn.disabled) return;
        const selects = card.querySelectorAll(".q-match-select");
        let allFilled = true;
        selects.forEach(s => { if (!s.value) allFilled = false; });
        if (!allFilled) {
          feedback.textContent = "Please match every term first, hm!";
          feedback.className = "q-feedback show bad";
          buzz();
          return;
        }
        btn.disabled = true;
        let allRight = true;
        selects.forEach(s => {
          s.disabled = true;
          if (s.value === s.dataset.correct) {
            s.classList.add("correct");
          } else {
            s.classList.add("wrong");
            allRight = false;
          }
        });
        if (allRight) {
          feedback.textContent = "✓ Perfect match! " + q.explain + " +150 bells!";
          feedback.className = "q-feedback show good";
          chime();
          awardBells(150, btn);
        } else {
          feedback.textContent = "Some matches were off. Look at the green ones to see what was correct.";
          feedback.className = "q-feedback show bad";
          buzz();
        }
        quizAnswered(idx, allRight);
      });
    }
  });
}

/* ===== TRACK QUIZ ANSWERS ===== */
const answered = new Map();
function quizAnswered(idx, correct) {
  answered.set(idx, correct);
  if (answered.size === QUESTIONS.length) {
    showScore();
  }
}

function showScore() {
  let correctCount = 0;
  answered.forEach(v => { if (v) correctCount++; });

  let msg = "";
  if (correctCount >= 27) msg = "Astonishing work! Nook Inc. is officially hiring, yes yes!";
  else if (correctCount >= 22) msg = "Excellent! You truly understand the basics of economics!";
  else if (correctCount >= 16) msg = "Solid effort! Maybe review the chapters you missed and try those tricky ones again.";
  else msg = "A respectable first try. Scroll back up and revisit the chapters, every villager improves with practice!";

  const scoreCard = document.createElement("div");
  scoreCard.className = "score-card show";
  scoreCard.innerHTML = `
    <div class="score-num">${correctCount}<span class="total"> / ${QUESTIONS.length}</span></div>
    <div class="score-label">Final Score!</div>
    <p class="score-msg">${msg}</p>
  `;
  quizArea.appendChild(scoreCard);
  scoreCard.scrollIntoView({ behavior: "smooth", block: "center" });
  chime();
  setTimeout(chime, 300);
}

renderQuiz();

/* ===== REFLECTION ===== */
const reflectionText = document.getElementById("reflectionText");
const wordCountEl = document.getElementById("wordCount");
reflectionText.addEventListener("input", () => {
  const words = reflectionText.value.trim().split(/\s+/).filter(w => w.length > 0);
  wordCountEl.textContent = words.length;
});

document.getElementById("reflectionSubmit").addEventListener("click", () => {
  const text = reflectionText.value.trim();
  const words = text.split(/\s+/).filter(w => w.length > 0);
  const wc = words.length;
  const lower = text.toLowerCase();

  const keywordsFound = [];
  ["scarcity", "demand", "supply", "goods", "services", "specialization", "market",
   "opportunity cost", "income", "resources", "equilibrium", "need", "want", "trade"]
    .forEach(k => { if (lower.includes(k)) keywordsFound.push(k); });

  let msg = "";
  if (wc < 30) {
    msg = "Hm hm, this is a fine start but quite short! Try to write at least 75 words. Explain WHAT you chose, WHAT you gave up, and WHETHER it was worth it.";
  } else if (wc < 75) {
    msg = "Coming along nicely, yes yes! You are at " + wc + " words. Stretch toward 75 by adding more details. What did giving that thing up feel like? Would you choose differently next time?";
  } else {
    let praise = "Marvelous work, my favorite future investor! ";
    praise += wc + " words exactly. ";
    if (keywordsFound.length >= 3) {
      praise += "I count " + keywordsFound.length + " economics keywords (" + keywordsFound.slice(0, 5).join(", ") + "). Excellent vocabulary, yes yes! ";
    } else if (keywordsFound.length > 0) {
      praise += "I see you used " + keywordsFound.length + " keyword(s): " + keywordsFound.join(", ") + ". Try to weave in a couple more from the lesson next time. ";
    } else {
      praise += "Try sprinkling in a few keywords from the lesson, like opportunity cost, scarcity, or demand. They make your writing more powerful! ";
    }
    praise += "You have officially completed the Economics Island Quest. 200 bonus bells, on the house!";
    msg = praise;
    awardBells(200);
    showCertificate();
  }

  document.getElementById("reflectionFeedback").textContent = msg;
  document.getElementById("reflectionResponse").classList.add("show");
  chime();
});

function showCertificate() {
  document.getElementById("finalBells").textContent = bellTotal + 200;
  const cert = document.getElementById("certificate");
  cert.classList.add("show");
  setTimeout(() => cert.scrollIntoView({ behavior: "smooth", block: "center" }), 400);
}

