<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Economics Island Quest, with Tom Nook</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700;800&family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
:root {
  --cream: #fff8e7;
  --cream-deep: #f4e9c8;
  --sand: #e8d49b;
  --leaf: #6fbf73;
  --leaf-deep: #3f9d57;
  --sea: #87cfe0;
  --sea-deep: #4a9fb8;
  --peach: #f4a261;
  --peach-deep: #e07a3e;
  --berry: #d96b78;
  --sky: #c9ecf5;
  --brown: #6b4a2a;
  --brown-deep: #4a3520;
  --paper: #fffaee;
  --shadow: rgba(75, 53, 32, 0.18);
  --shadow-deep: rgba(75, 53, 32, 0.32);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  font-family: 'Nunito', system-ui, sans-serif;
  font-weight: 600;
  color: var(--brown-deep);
  background:
    radial-gradient(ellipse at top, var(--sky) 0%, var(--cream) 35%, var(--cream) 60%, var(--cream-deep) 100%);
  min-height: 100vh;
  overflow-x: hidden;
  line-height: 1.6;
}

/* Decorative grass pattern at bottom of viewport */
body::after {
  content: "";
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 18px;
  background:
    radial-gradient(circle at 10px 14px, var(--leaf) 5px, transparent 6px),
    radial-gradient(circle at 30px 14px, var(--leaf-deep) 4px, transparent 5px),
    radial-gradient(circle at 50px 14px, var(--leaf) 6px, transparent 7px),
    radial-gradient(circle at 70px 14px, var(--leaf-deep) 4px, transparent 5px),
    var(--leaf);
  background-size: 80px 18px, 80px 18px, 80px 18px, 80px 18px, 100% 100%;
  background-repeat: repeat-x;
  z-index: 5;
  pointer-events: none;
  box-shadow: 0 -4px 0 rgba(63,157,87,0.4) inset;
}

/* === STICKY HEADER WITH PROGRESS === */
.hud {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 50;
  background: rgba(255,248,231,0.94);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  border-bottom: 3px solid var(--sand);
  padding: 10px 18px;
  display: flex;
  align-items: center;
  gap: 14px;
  box-shadow: 0 2px 14px var(--shadow);
}

.hud-title {
  font-family: 'Fredoka', sans-serif;
  font-weight: 700;
  font-size: 16px;
  color: var(--brown-deep);
  white-space: nowrap;
}

.hud-title span {
  color: var(--peach-deep);
}

.progress-track {
  flex: 1;
  height: 14px;
  background: var(--cream-deep);
  border: 2px solid var(--brown);
  border-radius: 999px;
  overflow: hidden;
  position: relative;
  box-shadow: inset 0 2px 0 rgba(75,53,32,0.1);
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--leaf) 0%, var(--leaf-deep) 100%);
  width: 0%;
  transition: width 0.4s ease;
  position: relative;
}

.progress-fill::after {
  content: "";
  position: absolute;
  top: 2px; left: 0; right: 0;
  height: 3px;
  background: rgba(255,255,255,0.4);
  border-radius: 999px;
}

.bells-counter {
  display: flex;
  align-items: center;
  gap: 6px;
  background: var(--paper);
  border: 2px solid var(--brown);
  border-radius: 999px;
  padding: 4px 12px 4px 6px;
  font-family: 'Press Start 2P', monospace;
  font-size: 11px;
  color: var(--brown-deep);
  box-shadow: 0 2px 0 var(--shadow);
}

.bells-counter img {
  width: 20px;
  height: 20px;
  image-rendering: pixelated;
}

.mute-btn {
  background: var(--paper);
  border: 2px solid var(--brown);
  border-radius: 50%;
  width: 36px;
  height: 36px;
  cursor: pointer;
  font-size: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 0 var(--shadow);
  transition: transform 0.1s;
}

.mute-btn:active { transform: translateY(2px); box-shadow: 0 0 0 var(--shadow); }

/* === HERO === */
.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 90px 24px 60px;
  position: relative;
}

.hero-clouds {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.cloud {
  position: absolute;
  background: white;
  border-radius: 100px;
  opacity: 0.7;
  filter: drop-shadow(0 8px 0 rgba(255,255,255,0.6));
}
.cloud::before, .cloud::after {
  content: "";
  position: absolute;
  background: white;
  border-radius: 50%;
}
.cloud-1 { top: 12%; left: 8%; width: 120px; height: 40px; animation: drift 50s linear infinite; }
.cloud-1::before { width: 60px; height: 60px; top: -28px; left: 20px; }
.cloud-1::after { width: 48px; height: 48px; top: -18px; left: 70px; }
.cloud-2 { top: 22%; right: 10%; width: 100px; height: 32px; animation: drift 70s linear infinite reverse; }
.cloud-2::before { width: 50px; height: 50px; top: -22px; left: 18px; }
.cloud-2::after { width: 38px; height: 38px; top: -14px; left: 56px; }

@keyframes drift {
  from { transform: translateX(-30px); }
  to { transform: translateX(40px); }
}

.hero-title {
  font-family: 'Fredoka', sans-serif;
  font-weight: 700;
  font-size: clamp(36px, 7vw, 72px);
  line-height: 1.05;
  color: var(--brown-deep);
  margin-bottom: 8px;
  text-shadow:
    3px 3px 0 var(--cream-deep),
    6px 6px 0 var(--sand);
  animation: pop-in 0.7s cubic-bezier(.34,1.56,.64,1);
}

.hero-title .emphasis {
  color: var(--peach-deep);
  display: block;
}

.hero-subtitle {
  font-family: 'Fredoka', sans-serif;
  font-weight: 500;
  font-size: clamp(16px, 2.4vw, 22px);
  color: var(--brown);
  margin-top: 14px;
  max-width: 600px;
}

.hero-nook {
  width: clamp(180px, 28vw, 280px);
  height: auto;
  image-rendering: pixelated;
  image-rendering: -moz-crisp-edges;
  image-rendering: crisp-edges;
  margin: 28px 0 18px;
  animation: nook-bob 2.8s ease-in-out infinite;
  filter: drop-shadow(0 12px 0 rgba(75,53,32,0.15));
}

@keyframes nook-bob {
  0%, 100% { transform: translateY(0) rotate(-1deg); }
  50% { transform: translateY(-8px) rotate(1deg); }
}

@keyframes pop-in {
  0% { opacity: 0; transform: scale(0.85) translateY(20px); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

.start-btn {
  font-family: 'Fredoka', sans-serif;
  font-weight: 600;
  font-size: 22px;
  background: var(--peach);
  color: white;
  border: 3px solid var(--brown);
  border-radius: 999px;
  padding: 16px 38px;
  cursor: pointer;
  box-shadow: 0 5px 0 var(--brown), 0 8px 18px var(--shadow);
  transition: all 0.15s;
  margin-top: 22px;
  letter-spacing: 0.5px;
}

.start-btn:hover {
  background: var(--peach-deep);
  transform: translateY(-2px);
  box-shadow: 0 7px 0 var(--brown), 0 10px 22px var(--shadow);
}
.start-btn:active {
  transform: translateY(5px);
  box-shadow: 0 0 0 var(--brown), 0 2px 6px var(--shadow);
}

.scroll-hint {
  margin-top: 30px;
  font-family: 'Fredoka', sans-serif;
  color: var(--brown);
  font-size: 14px;
  opacity: 0.7;
  animation: bounce-hint 2s ease-in-out infinite;
}

@keyframes bounce-hint {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(6px); }
}

/* === SECTIONS === */
.section {
  max-width: 820px;
  margin: 0 auto;
  padding: 70px 24px;
  position: relative;
}

.section-tag {
  display: inline-block;
  font-family: 'Press Start 2P', monospace;
  font-size: 10px;
  background: var(--leaf);
  color: white;
  padding: 8px 14px;
  border: 2px solid var(--brown);
  border-radius: 6px;
  margin-bottom: 12px;
  box-shadow: 0 3px 0 var(--shadow-deep);
  letter-spacing: 1px;
}

.section h2 {
  font-family: 'Fredoka', sans-serif;
  font-weight: 700;
  font-size: clamp(28px, 5vw, 44px);
  color: var(--brown-deep);
  line-height: 1.1;
  margin-bottom: 22px;
  text-shadow: 2px 2px 0 var(--cream-deep);
}

.section h2 .accent { color: var(--peach-deep); }

.section h3 {
  font-family: 'Fredoka', sans-serif;
  font-weight: 600;
  font-size: 24px;
  color: var(--leaf-deep);
  margin: 32px 0 12px;
}

.section p {
  font-size: 17px;
  margin: 14px 0;
  color: var(--brown-deep);
}

/* === DIALOGUE BOX (Animal Crossing style) === */
.dialogue {
  background: var(--paper);
  border: 3px solid var(--brown);
  border-radius: 18px;
  padding: 20px 22px 22px 22px;
  margin: 24px 0;
  position: relative;
  box-shadow: 0 5px 0 var(--brown), 0 10px 26px var(--shadow);
  display: flex;
  gap: 14px;
  align-items: flex-start;
}

.dialogue::after {
  content: "▼";
  position: absolute;
  bottom: 8px;
  right: 16px;
  color: var(--brown);
  font-size: 10px;
  animation: tap-blink 1s ease-in-out infinite;
}

@keyframes tap-blink {
  0%, 60%, 100% { opacity: 1; transform: translateY(0); }
  30% { opacity: 0.3; transform: translateY(2px); }
}

.dialogue-avatar {
  flex-shrink: 0;
  width: 64px;
  height: 64px;
  background: var(--cream-deep);
  border: 2px solid var(--brown);
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.dialogue-avatar img {
  width: 110%;
  height: 110%;
  object-fit: contain;
  object-position: bottom;
  image-rendering: pixelated;
  margin-bottom: -8px;
}

.dialogue-body {
  flex: 1;
  min-width: 0;
}

.dialogue-name {
  font-family: 'Fredoka', sans-serif;
  font-weight: 700;
  font-size: 14px;
  color: var(--peach-deep);
  margin-bottom: 4px;
  letter-spacing: 0.5px;
}

.dialogue-text {
  font-size: 17px;
  color: var(--brown-deep);
  font-weight: 600;
  min-height: 24px;
}

/* === KEYWORD CHIPS === */
.kw {
  display: inline-block;
  background: var(--sea);
  color: var(--brown-deep);
  padding: 1px 8px;
  border-radius: 6px;
  border-bottom: 2px solid var(--sea-deep);
  font-weight: 800;
  cursor: pointer;
  transition: all 0.15s;
  position: relative;
  text-decoration: none;
  white-space: nowrap;
}

.kw::before {
  content: "🔍";
  font-size: 10px;
  margin-right: 4px;
  opacity: 0.7;
}

.kw:hover {
  background: var(--peach);
  border-bottom-color: var(--peach-deep);
  transform: translateY(-1px);
  box-shadow: 0 2px 0 var(--shadow);
}

.kw:active {
  transform: translateY(0);
}

/* === DEFINITION POPUP === */
.def-overlay {
  position: fixed;
  inset: 0;
  background: rgba(75,53,32,0.55);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 20px;
  animation: fade-in 0.2s ease;
}
.def-overlay.show { display: flex; }

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.def-card {
  background: var(--paper);
  border: 3px solid var(--brown);
  border-radius: 22px;
  max-width: 480px;
  width: 100%;
  padding: 26px 26px 22px;
  position: relative;
  box-shadow: 0 8px 0 var(--brown), 0 15px 40px var(--shadow-deep);
  animation: slide-up 0.25s cubic-bezier(.34,1.56,.64,1);
}

@keyframes slide-up {
  from { opacity: 0; transform: translateY(30px) scale(0.95); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.def-card .word {
  font-family: 'Fredoka', sans-serif;
  font-weight: 700;
  font-size: 28px;
  color: var(--peach-deep);
  margin-bottom: 6px;
}

.def-card .pronounce {
  font-family: 'Press Start 2P', monospace;
  font-size: 9px;
  color: var(--brown);
  opacity: 0.7;
  margin-bottom: 14px;
  letter-spacing: 1px;
}

.def-card .meaning {
  font-size: 17px;
  color: var(--brown-deep);
  margin-bottom: 16px;
}

.def-card .stick-it {
  background: var(--sky);
  border-left: 4px solid var(--sea-deep);
  padding: 12px 14px;
  border-radius: 0 10px 10px 0;
  font-size: 15px;
  color: var(--brown-deep);
  margin-bottom: 16px;
}

.def-card .stick-it strong {
  color: var(--sea-deep);
  font-family: 'Fredoka', sans-serif;
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 1px;
  display: block;
  margin-bottom: 4px;
}

.def-close {
  width: 100%;
  font-family: 'Fredoka', sans-serif;
  font-weight: 600;
  font-size: 17px;
  background: var(--leaf);
  color: white;
  border: 3px solid var(--brown);
  border-radius: 999px;
  padding: 10px 20px;
  cursor: pointer;
  box-shadow: 0 4px 0 var(--brown);
  transition: all 0.12s;
}

.def-close:hover { background: var(--leaf-deep); }
.def-close:active { transform: translateY(4px); box-shadow: 0 0 0 var(--brown); }

/* === EXAMPLE CARDS === */
.example-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
  margin: 22px 0;
}

.example-card {
  background: var(--paper);
  border: 3px solid var(--brown);
  border-radius: 16px;
  padding: 16px;
  box-shadow: 0 4px 0 var(--shadow-deep);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 8px;
  transition: transform 0.2s;
}

.example-card:hover {
  transform: translateY(-3px) rotate(-1deg);
}

.example-card img {
  width: 64px;
  height: 64px;
  object-fit: contain;
}

.example-card .label {
  font-family: 'Fredoka', sans-serif;
  font-weight: 600;
  font-size: 15px;
  color: var(--brown-deep);
}

.example-card .sub {
  font-size: 13px;
  color: var(--brown);
  opacity: 0.85;
}

/* Tag variants on cards */
.example-card.peach { background: #ffe3cf; }
.example-card.leaf { background: #d8f0d4; }
.example-card.sea { background: #d2eef7; }
.example-card.sand { background: #f4e9c8; }

/* === REAL WORLD CALLOUT === */
.real-world {
  background: linear-gradient(135deg, #d2eef7 0%, #c9ecf5 100%);
  border: 3px solid var(--sea-deep);
  border-radius: 18px;
  padding: 20px 22px;
  margin: 28px 0;
  position: relative;
  box-shadow: 0 4px 0 var(--sea-deep), 0 8px 20px var(--shadow);
}

.real-world::before {
  content: "🌎 REAL WORLD";
  position: absolute;
  top: -14px;
  left: 18px;
  background: var(--sea-deep);
  color: white;
  font-family: 'Press Start 2P', monospace;
  font-size: 9px;
  padding: 6px 10px;
  border-radius: 6px;
  border: 2px solid var(--brown);
  letter-spacing: 1px;
}

.real-world p { margin: 8px 0; font-size: 16px; }

/* === MEMORY HOOK === */
.memory-hook {
  background: linear-gradient(135deg, #fff3d4 0%, #ffe9b8 100%);
  border: 3px dashed var(--peach-deep);
  border-radius: 16px;
  padding: 16px 18px;
  margin: 22px 0;
  font-size: 16px;
  color: var(--brown-deep);
  position: relative;
}

.memory-hook::before {
  content: "🧠";
  font-size: 26px;
  position: absolute;
  top: -16px;
  left: 14px;
  background: var(--paper);
  border-radius: 50%;
  padding: 2px 6px;
  border: 2px solid var(--peach-deep);
}

.memory-hook strong {
  color: var(--peach-deep);
  font-family: 'Fredoka', sans-serif;
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 1px;
  display: block;
  margin-bottom: 4px;
  padding-left: 32px;
}

/* === NOOK CHECK (mini quiz between sections) === */
.nook-check {
  background: var(--paper);
  border: 3px solid var(--peach-deep);
  border-radius: 20px;
  padding: 22px;
  margin: 32px 0;
  box-shadow: 0 5px 0 var(--peach-deep), 0 10px 24px var(--shadow);
  position: relative;
}

.nook-check::before {
  content: "✦ NOOK CHECK ✦";
  display: block;
  font-family: 'Press Start 2P', monospace;
  font-size: 11px;
  color: var(--peach-deep);
  text-align: center;
  margin-bottom: 12px;
  letter-spacing: 2px;
}

.nook-check-q {
  font-family: 'Fredoka', sans-serif;
  font-size: 18px;
  color: var(--brown-deep);
  margin-bottom: 14px;
  font-weight: 600;
}

.nook-check-opts {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.nook-opt {
  background: var(--cream);
  border: 2px solid var(--brown);
  border-radius: 12px;
  padding: 12px 14px;
  font-family: 'Nunito', sans-serif;
  font-weight: 600;
  font-size: 16px;
  cursor: pointer;
  text-align: left;
  color: var(--brown-deep);
  transition: all 0.15s;
  box-shadow: 0 3px 0 var(--shadow);
}

.nook-opt:hover:not(:disabled) {
  background: var(--cream-deep);
  transform: translateX(4px);
}

.nook-opt.correct {
  background: var(--leaf);
  color: white;
  border-color: var(--leaf-deep);
  box-shadow: 0 3px 0 var(--leaf-deep);
}

.nook-opt.wrong {
  background: #f0a4ad;
  color: white;
  border-color: var(--berry);
  box-shadow: 0 3px 0 var(--berry);
}

.nook-opt:disabled { cursor: not-allowed; opacity: 0.7; }
.nook-opt.correct:disabled, .nook-opt.wrong:disabled { opacity: 1; }

.nook-feedback {
  margin-top: 12px;
  padding: 10px 14px;
  border-radius: 10px;
  font-size: 15px;
  display: none;
}

.nook-feedback.show { display: block; animation: fade-in 0.3s; }
.nook-feedback.good { background: #d8f0d4; color: var(--leaf-deep); border-left: 4px solid var(--leaf-deep); }
.nook-feedback.bad { background: #f9dadd; color: var(--berry); border-left: 4px solid var(--berry); }

/* === QUIZ SECTION === */
.quiz-intro {
  text-align: center;
  padding: 50px 20px;
  background: linear-gradient(180deg, var(--cream) 0%, var(--sand) 100%);
  border-top: 4px solid var(--brown);
  border-bottom: 4px solid var(--brown);
  margin: 60px 0 0;
}

.quiz-intro h2 {
  font-family: 'Fredoka', sans-serif;
  font-size: clamp(32px, 6vw, 52px);
  color: var(--brown-deep);
  text-shadow: 3px 3px 0 var(--cream-deep);
}

.quiz-intro p {
  font-size: 18px;
  max-width: 520px;
  margin: 16px auto;
  color: var(--brown-deep);
}

.quiz-area {
  max-width: 820px;
  margin: 0 auto;
  padding: 40px 24px 80px;
}

.q-card {
  background: var(--paper);
  border: 3px solid var(--brown);
  border-radius: 18px;
  padding: 24px;
  margin: 18px 0;
  box-shadow: 0 5px 0 var(--shadow-deep);
}

.q-num {
  display: inline-block;
  font-family: 'Press Start 2P', monospace;
  font-size: 10px;
  background: var(--brown);
  color: var(--cream);
  padding: 6px 10px;
  border-radius: 6px;
  margin-bottom: 10px;
}

.q-type {
  display: inline-block;
  font-family: 'Press Start 2P', monospace;
  font-size: 9px;
  padding: 6px 9px;
  border-radius: 6px;
  margin-left: 6px;
  color: white;
}
.q-type.tf { background: var(--sea-deep); }
.q-type.mc { background: var(--leaf-deep); }
.q-type.fib { background: var(--peach-deep); }
.q-type.match { background: var(--berry); }

.q-text {
  font-family: 'Fredoka', sans-serif;
  font-size: 19px;
  color: var(--brown-deep);
  margin: 8px 0 16px;
  font-weight: 600;
}

.q-opts {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.q-opt {
  background: var(--cream);
  border: 2px solid var(--brown);
  border-radius: 12px;
  padding: 11px 14px;
  font-family: 'Nunito', sans-serif;
  font-weight: 600;
  font-size: 16px;
  cursor: pointer;
  text-align: left;
  color: var(--brown-deep);
  transition: all 0.15s;
  box-shadow: 0 3px 0 var(--shadow);
}

.q-opt:hover:not(:disabled) {
  background: var(--cream-deep);
  transform: translateX(3px);
}

.q-opt.correct {
  background: var(--leaf);
  color: white;
  border-color: var(--leaf-deep);
  box-shadow: 0 3px 0 var(--leaf-deep);
}

.q-opt.wrong {
  background: #f0a4ad;
  color: white;
  border-color: var(--berry);
