});

/* ===== TYPEWRITER EFFECT FOR DIALOGUE ===== */
const observedDialogues = new WeakSet();

function typeOut(el) {
  if (observedDialogues.has(el)) return;
  observedDialogues.add(el);
  const fullText = el.dataset.text || el.textContent;
  el.dataset.text = fullText;
  el.textContent = "";
  let i = 0;
  const tick = () => {
    if (i >= fullText.length) return;
    el.textContent += fullText.charAt(i);
    const ch = fullText.charAt(i);
    if (i % 3 === 0 && ch !== " " && ch !== "," && ch !== ".") {
      blip(520 + Math.random() * 60, 0.018, "square", 0.025);
    }
    i++;
    setTimeout(tick, ch === "." || ch === "!" || ch === "?" ? 180 : (ch === "," ? 90 : 28));
  };
  tick();
}

