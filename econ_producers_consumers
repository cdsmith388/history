    border: none;
    padding: 12px 26px;
    border-radius: 999px;
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    cursor: pointer;
    box-shadow: 0 4px 0 #B8410F;
