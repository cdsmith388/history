  }
  .reflection .prompts li { margin-bottom: 6px; }
  .reflection textarea {
    width: 100%;
    min-height: 180px;
    font-family: 'Nunito', sans-serif;
    font-size: 1.05rem;
    line-height: 1.6;
    padding: 14px;
    border: 2px solid var(--wood-mid);
