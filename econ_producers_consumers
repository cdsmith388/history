  setTimeout(() => {
    outroBox.classList.add('show');
    finalBells.textContent = bells.toLocaleString();
    burstConfetti();
    burstConfetti();
    typeDialogue("Bravo! Truly excellent work, yes yes! Until next lesson, my friend!");
