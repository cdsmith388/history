/* ============================================================
   BUILD QUIZ
   ============================================================ */
const quizContainer = document.getElementById('quizContainer');
const responses = {}; // qIdx -> stored answer info

// Word bank for fill-in-the-blank
const FIB_WORDS = ["producer", "consumer", "interdependence", "chain", "opportunity", "patterns", "revenue", "service"];

function buildWordBank() {
  const bank = document.createElement('div');
  bank.className = 'word-bank';
  bank.innerHTML = '<div class="word-bank-label">📦 WORD BANK (use these to fill in the blanks)</div>' +
    FIB_WORDS.map(w => '<span class="word-chip">' + w + '</span>').join('');
  return bank;
}

let qCounter = 0;
let mcSectionStarted = false;
let fibSectionStarted = false;
let tfSectionStarted = false;
let matchSectionStarted = false;

QUIZ.forEach((q, idx) => {
  // Add section header / word bank before relevant groups
  if (q.type === 'tf' && !tfSectionStarted) {
    tfSectionStarted = true;
    const h = document.createElement('h3');
    h.style.cssText = 'font-family:Fredoka,sans-serif; color:var(--nook-brown); font-size:1.4rem; margin:30px 0 14px; text-align:center;';
    h.textContent = '✅ True or False (10 questions)';
    quizContainer.appendChild(h);
  }
  if (q.type === 'fib' && !fibSectionStarted) {
    fibSectionStarted = true;
    const h = document.createElement('h3');
    h.style.cssText = 'font-family:Fredoka,sans-serif; color:var(--nook-brown); font-size:1.4rem; margin:30px 0 14px; text-align:center;';
    h.textContent = '✏️ Fill in the Blanks (8 questions)';
    quizContainer.appendChild(h);
    quizContainer.appendChild(buildWordBank());
  }
  if (q.type === 'match' && !matchSectionStarted) {
    matchSectionStarted = true;
    const h = document.createElement('h3');
    h.style.cssText = 'font-family:Fredoka,sans-serif; color:var(--nook-brown); font-size:1.4rem; margin:30px 0 14px; text-align:center;';
    h.textContent = '🔗 Matching (6 pairs)';
    quizContainer.appendChild(h);
  }
  if (q.type === 'mc' && !mcSectionStarted) {
    mcSectionStarted = true;
    const h = document.createElement('h3');
    h.style.cssText = 'font-family:Fredoka,sans-serif; color:var(--nook-brown); font-size:1.4rem; margin:30px 0 14px; text-align:center;';
    h.textContent = '🎯 Multiple Choice (6 questions)';
    quizContainer.appendChild(h);
  }

  const card = document.createElement('div');
  card.className = 'quiz-card';

  if (q.type === 'tf' || q.type === 'fib' || q.type === 'mc') {
    qCounter++;
    card.innerHTML =
      '<span class="q-num">Q' + qCounter + '</span>' +
      '<span class="q-type">' + ({tf:'TRUE / FALSE', fib:'FILL IN BLANK', mc:'MULTIPLE CHOICE', match:'MATCHING'})[q.type] + '</span>' +
      '<div class="q-prompt">' + q.prompt + '</div>';

    if (q.type === 'tf') {
      const opts = document.createElement('div');
      opts.className = 'q-options tf';
      ['T', 'F'].forEach(v => {
        const btn = document.createElement('button');
        btn.className = 'q-option';
        btn.textContent = v === 'T' ? '👍 True' : '👎 False';
        btn.dataset.val = v;
        btn.addEventListener('click', () => answerTF(card, btn, q, idx, v));
        opts.appendChild(btn);
      });
      card.appendChild(opts);
    } else if (q.type === 'mc') {
      const opts = document.createElement('div');
      opts.className = 'q-options';
      q.options.forEach((opt, i) => {
        const btn = document.createElement('button');
        btn.className = 'q-option';
        btn.textContent = String.fromCharCode(65 + i) + '. ' + opt;
        btn.dataset.val = i;
        btn.addEventListener('click', () => answerMC(card, btn, opts, q, idx, i));
        opts.appendChild(btn);
      });
      card.appendChild(opts);
    } else if (q.type === 'fib') {
      const wrap = document.createElement('div');
      const input = document.createElement('input');
      input.type = 'text';
      input.className = 'q-blank';
      input.placeholder = 'Type your answer...';
      input.autocomplete = 'off';
      const submit = document.createElement('button');
      submit.className = 'q-submit';
      submit.textContent = 'Check ✓';
      submit.addEventListener('click', () => answerFIB(card, input, submit, q, idx));
      input.addEventListener('keydown', e => { if (e.key === 'Enter') submit.click(); });
      wrap.appendChild(input);
      wrap.appendChild(document.createTextNode(' '));
      wrap.appendChild(submit);
      card.appendChild(wrap);
    }

    const fb = document.createElement('div');
    fb.className = 'q-feedback';
    card.appendChild(fb);
  } else if (q.type === 'match') {
    card.innerHTML =
      '<span class="q-num">Q' + (qCounter + 1) + '-' + (qCounter + q.pairs.length) + '</span>' +
      '<span class="q-type">MATCHING</span>' +
      '<div class="q-prompt">' + q.prompt + '</div>';
    qCounter += q.pairs.length;
    buildMatching(card, q, idx);
  }

  quizContainer.appendChild(card);
});

/* ============================================================
   QUIZ HANDLERS
   ============================================================ */
function showFeedback(card, ok, text) {
  const fb = card.querySelector('.q-feedback');
  fb.classList.add('show');
  fb.classList.toggle('ok', ok);
  fb.classList.toggle('no', !ok);
  fb.textContent = (ok ? '✅ Yes yes! ' : '❌ Not quite. ') + text;
}

function answerTF(card, btn, q, idx, val) {
  if (responses[idx]) return;
  card.querySelectorAll('.q-option').forEach(b => b.classList.add('disabled'));
  const ok = val === q.answer;
  if (ok) {
    btn.classList.add('correct');
    addBells(15);
    chime(true);
  } else {
    btn.classList.add('wrong');
    card.querySelectorAll('.q-option').forEach(b => {
      if (b.dataset.val === q.answer) b.classList.add('correct');
    });
    chime(false);
  }
  responses[idx] = { correct: ok, count: 1 };
  showFeedback(card, ok, q.explain);
}

function answerMC(card, btn, opts, q, idx, val) {
  if (responses[idx]) return;
  opts.querySelectorAll('.q-option').forEach(b => b.classList.add('disabled'));
  const ok = val === q.answer;
  if (ok) {
    btn.classList.add('correct');
    addBells(15);
    chime(true);
  } else {
    btn.classList.add('wrong');
    opts.querySelectorAll('.q-option').forEach(b => {
      if (parseInt(b.dataset.val) === q.answer) b.classList.add('correct');
    });
    chime(false);
  }
  responses[idx] = { correct: ok, count: 1 };
  showFeedback(card, ok, q.explain);
}

function answerFIB(card, input, btn, q, idx) {
  if (responses[idx]) return;
  const val = (input.value || '').trim().toLowerCase();
  if (!val) return;
  const ok = q.answer.some(a => val === a.toLowerCase() || val.includes(a.toLowerCase()));
  responses[idx] = { correct: ok, count: 1 };
  if (ok) {
    input.style.borderColor = 'var(--ok)';
    input.style.background = '#C8E6C9';
    addBells(15);
    chime(true);
  } else {
    input.style.borderColor = 'var(--bad)';
    input.style.background = '#FFCDD2';
    chime(false);
  }
  btn.disabled = true;
  btn.style.opacity = 0.5;
  input.disabled = true;
  showFeedback(card, ok, ok ? q.explain : ('The answer was: <strong>' + q.answer[0] + '</strong>. ' + q.explain));
  card.querySelector('.q-feedback').innerHTML = (ok ? '✅ Yes yes! ' : '❌ Not quite. ') + (ok ? q.explain : ('The answer was: <strong>' + q.answer[0] + '</strong>. ' + q.explain));
}

/* MATCHING */
function buildMatching(card, q, idx) {
  const wrap = document.createElement('div');
  wrap.className = 'matching';

  // Shuffle right side
  const lefts = q.pairs.map((p, i) => ({ text: p.left, pairId: i }));
  const rights = q.pairs.map((p, i) => ({ text: p.right, pairId: i }));
  // Don't shuffle lefts; shuffle rights
  const shuffledRights = rights.slice().sort(() => Math.random() - 0.5);
  // Also shuffle lefts a bit
  const shuffledLefts = lefts.slice().sort(() => Math.random() - 0.5);

  const colL = document.createElement('div');
  colL.className = 'm-col';
  colL.innerHTML = '<h4>Examples</h4>';
  shuffledLefts.forEach((item) => {
    const el = document.createElement('div');
    el.className = 'm-item';
    el.textContent = item.text;
    el.dataset.pairId = item.pairId;
    el.dataset.side = 'left';
    colL.appendChild(el);
  });

  const colR = document.createElement('div');
  colR.className = 'm-col';
  colR.innerHTML = '<h4>Type</h4>';
  // Right column duplicates Producer/Consumer multiple times -- to make it real matching, give each right item a unique pair id
  // We'll show rights as draggable cards too, one per pair
  shuffledRights.forEach((item) => {
    const el = document.createElement('div');
    el.className = 'm-item';
    el.textContent = item.text;
    el.dataset.pairId = item.pairId;
    el.dataset.side = 'right';
    colR.appendChild(el);
  });

  wrap.appendChild(colL);
  wrap.appendChild(colR);
  card.appendChild(wrap);

  const fb = document.createElement('div');
  fb.className = 'q-feedback';
  card.appendChild(fb);

  let selected = null;
  let pairCount = 0;
  const totalPairs = q.pairs.length;
  let correctPairs = 0;

  wrap.querySelectorAll('.m-item').forEach(item => {
    item.addEventListener('click', () => {
      if (item.classList.contains('matched-1') || item.classList.contains('matched-2') ||
          item.classList.contains('matched-3') || item.classList.contains('matched-4') ||
          item.classList.contains('matched-5') || item.classList.contains('matched-6')) return;

      if (!selected) {
        selected = item;
        item.classList.add('selected');
        playBlip(500, 0.05, "square");
        return;
      }
      if (selected === item) {
        selected.classList.remove('selected');
        selected = null;
        return;
      }
      if (selected.dataset.side === item.dataset.side) {
        selected.classList.remove('selected');
        selected = item;
        item.classList.add('selected');
        return;
      }
      // Attempt to pair
      pairCount++;
      const isMatch = selected.dataset.pairId === item.dataset.pairId;
      if (isMatch) {
        correctPairs++;
        const colorClass = 'matched-' + ((correctPairs % 6) + 1);
        selected.classList.add(colorClass);
        item.classList.add(colorClass);
        selected.classList.remove('selected');
        addBells(10);
        chime(true);
        // Add pair tag
        const tagL = document.createElement('span'); tagL.className = 'pair-tag'; tagL.textContent = correctPairs;
        const tagR = document.createElement('span'); tagR.className = 'pair-tag'; tagR.textContent = correctPairs;
        selected.insertBefore(tagL, selected.firstChild);
        item.insertBefore(tagR, item.firstChild);
        selected = null;
        if (correctPairs === totalPairs) {
          // Done!
          responses[idx] = { correct: totalPairs, count: totalPairs };
          fb.classList.add('show', 'ok');
          fb.innerHTML = '✅ All matched! ' + totalPairs + ' out of ' + totalPairs + '. Excellent, yes yes!';
        }
      } else {
        const a = selected, b = item;
        a.style.transition = 'transform 0.2s';
        b.style.transition = 'transform 0.2s';
        a.style.transform = 'translateX(-6px)';
        b.style.transform = 'translateX(6px)';
        chime(false);
        setTimeout(() => {
          a.style.transform = ''; b.style.transform = '';
          a.classList.remove('selected');
        }, 200);
        selected = null;
        // Track wrong attempts as a question that lost an attempt
        if (!responses[idx]) {
          responses[idx] = { correct: 0, count: totalPairs, attempts: 0 };
        }
      }
    });
  });

  // Mark response baseline
  if (!responses[idx]) {
    responses[idx] = { correct: 0, count: totalPairs };
  }
}

/* ============================================================
   FINISH QUIZ + SCORE
   ============================================================ */
const finishBtn = document.getElementById('finishQuizBtn');
const scoreBox = document.getElementById('scoreBox');
const scoreNum = document.getElementById('scoreNum');
const scoreMessage = document.getElementById('scoreMessage');
const scoreBreakdown = document.getElementById('scoreBreakdown');

finishBtn.addEventListener('click', () => {
  let total = 0;
  let earned = 0;
  let tfC = 0, tfT = 0, fibC = 0, fibT = 0, mcC = 0, mcT = 0, matchC = 0, matchT = 0;
  QUIZ.forEach((q, idx) => {
    const r = responses[idx];
    if (q.type === 'match') {
      matchT += q.pairs.length;
      total += q.pairs.length;
      if (r) {
        matchC += r.correct;
        earned += r.correct;
      }
    } else {
      total += 1;
      if (q.type === 'tf') tfT++;
      if (q.type === 'fib') fibT++;
      if (q.type === 'mc') mcT++;
      if (r && r.correct) {
        earned += 1;
        if (q.type === 'tf') tfC++;
        if (q.type === 'fib') fibC++;
        if (q.type === 'mc') mcC++;
      }
    }
  });

  scoreBox.classList.add('show');
  let displayed = 0;
  const targetScore = earned;
  const tickInterval = setInterval(() => {
    displayed++;
    scoreNum.textContent = displayed;
    if (displayed >= targetScore) clearInterval(tickInterval);
  }, 60);

  const pct = total > 0 ? (earned / total) * 100 : 0;
  let msg = "";
  if (pct >= 90) msg = "Absolutely BRILLIANT, yes yes! 🌟 You have mastered this, my excellent student!";
  else if (pct >= 75) msg = "Very good, hm hm! A few rough spots, but you understand the big ideas!";
  else if (pct >= 60) msg = "A solid effort! Go back and click the keywords you missed, then try again, ho ho!";
  else if (pct >= 40) msg = "Good attempt! Let us review the lesson together once more, yes yes.";
  else msg = "Do not be discouraged, my friend! Even Tom Nook had to learn this. Read again and you will improve!";

  scoreMessage.textContent = msg;

  scoreBreakdown.innerHTML = '';
  function addPill(name, c, t) {
    const p = document.createElement('div');
    p.className = 'b-pill';
    p.innerHTML = name + ': <strong>' + c + '/' + t + '</strong>';
    scoreBreakdown.appendChild(p);
  }
  addPill('True/False', tfC, tfT);
  addPill('Fill in Blank', fibC, fibT);
  addPill('Matching', matchC, matchT);
  addPill('Multiple Choice', mcC, mcT);

  // Big bell bonus for completion
  addBells(earned * 10);

  // Burst confetti
  burstConfetti();

  // Scroll to score
  setTimeout(() => scoreBox.scrollIntoView({ behavior: 'smooth', block: 'start' }), 200);

  typeDialogue("Quiz complete, yes yes! " + earned + " out of " + total + ". Now please write your reflection, hm hm.");
});

