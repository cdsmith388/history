    pointer-events: none;
    z-index: 300;
    animation: fall 3s linear forwards;
  }
  @keyframes fall {
    to { transform: translateY(110vh) rotate(720deg); opacity: 0; }
  }

  /* ----- Responsive tweaks ----- */
  @media (max-width: 600px) {
    .matching { grid-template-columns: 1fr; }
