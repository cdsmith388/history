      if (choice === correctAns) {
        btn.classList.add('correct');
        fb.textContent = "Excellent! Yes yes! 🎉";
        fb.className = 'qc-feedback show ok';
        addBells(8);
        chime(true);
      } else {
        btn.classList.add('wrong');
        buttons.forEach(b => {
          if (b.dataset.qc === correctAns) b.classList.add('correct');
        });
        fb.textContent = "Not quite! The correct answer is highlighted. Don't worry, that's how we learn, hm hm!";
        fb.className = 'qc-feedback show no';
        chime(false);
      }
    });
  });
});

