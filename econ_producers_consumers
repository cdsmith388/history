const dialogueBox = document.getElementById('dialogueBox');
const dialogueText = document.getElementById('dialogueText');
let typingInterval = null;
let currentDialogue = "";
let dialogueShownFor = new Set();

function typeDialogue(text) {
  clearInterval(typingInterval);
  currentDialogue = text;
  dialogueBox.classList.remove('hidden');
  dialogueText.innerHTML = "";
  let i = 0;
  const speed = 32;
  typingInterval = setInterval(() => {
    if (i >= text.length) {
      clearInterval(typingInterval);
      dialogueText.innerHTML = text + '<span class="blink"></span>';
      return;
    }
    const ch = text.charAt(i);
    dialogueText.textContent += ch;
    if (ch && ch !== ' ' && i % 2 === 0) {
      playBlip(380 + Math.random() * 80, 0.04, "square");
    }
    i++;
  }, speed);
}

function skipDialogue() {
  clearInterval(typingInterval);
  dialogueText.innerHTML = currentDialogue + '<span class="blink"></span>';
}

dialogueBox.addEventListener('click', (e) => {
  if (e.target.id === 'closeDialogue') return;
  skipDialogue();
});

