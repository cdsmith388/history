<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Tom Nook's Island Academy: Producers and Consumers</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700;800&family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-cream: #FFF8E7;
    --bg-paper: #FFFBF0;
    --grass: #82C341;
    --grass-dark: #5CA830;
    --leaf-dark: #3F7B1E;
    --nook-brown: #6B4423;
    --nook-light: #A0764A;
    --wood-light: #D4B583;
    --wood-mid: #B58D5E;
    --wood-dark: #8B6F47;
    --sky: #B5E3FF;
    --sky-deep: #6BBBE8;
    --bells: #FFC93C;
    --bells-deep: #E0A82E;
    --text: #3D2817;
    --text-soft: #5C4530;
    --hint: #FFE082;
    --pink: #FFB7C5;
    --leaf: #C1E89A;
    --bubble: #FFFFFF;
    --bubble-shadow: rgba(61, 40, 23, 0.18);
    --ok: #4CAF50;
    --bad: #E74C3C;
    --highlight: #FFEB99;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Nunito', system-ui, sans-serif;
    background: var(--bg-cream);
    color: var(--text);
    line-height: 1.6;
    overflow-x: hidden;
    background-image:
      radial-gradient(circle at 20% 10%, rgba(255,201,60,0.08) 0, transparent 40%),
      radial-gradient(circle at 80% 60%, rgba(130,195,65,0.10) 0, transparent 40%),
      radial-gradient(circle at 50% 90%, rgba(181,227,255,0.10) 0, transparent 40%);
  }

  /* ----- Top progress + bells bar ----- */
  .top-bar {
    position: fixed; top: 0; left: 0; right: 0;
    background: rgba(255, 248, 231, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 3px solid var(--wood-dark);
    z-index: 100;
    padding: 8px 16px;
    display: flex; align-items: center; gap: 14px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }
  .top-bar .logo {
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--nook-brown);
    white-space: nowrap;
  }
  .progress-track {
    flex: 1;
    height: 18px;
    background: var(--wood-light);
    border-radius: 999px;
    border: 2px solid var(--wood-dark);
    overflow: hidden;
    position: relative;
  }
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--grass) 0%, var(--grass-dark) 100%);
    width: 0%;
    transition: width 0.25s ease;
    border-radius: 999px;
  }
  .bells-counter {
    display: flex; align-items: center; gap: 6px;
    background: var(--bells);
    border: 2px solid var(--bells-deep);
    border-radius: 999px;
    padding: 4px 12px;
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    color: var(--nook-brown);
    box-shadow: 0 2px 0 var(--bells-deep);
  }
  .bells-counter .bell-icon {
    width: 18px; height: 18px;
    background: radial-gradient(circle at 35% 30%, #FFF8B0 0%, #FFD700 50%, #B8860B 100%);
    border-radius: 50%;
    border: 1.5px solid #8B6914;
    box-shadow: inset 0 -2px 0 rgba(0,0,0,0.18);
  }
  .mute-btn {
    background: var(--bubble);
    border: 2px solid var(--wood-dark);
    border-radius: 50%;
    width: 36px; height: 36px;
    cursor: pointer;
    font-size: 1rem;
    display: flex; align-items: center; justify-content: center;
    transition: transform 0.15s;
  }
  .mute-btn:hover { transform: scale(1.08); }
  .mute-btn:active { transform: scale(0.96); }

  /* ----- Hero ----- */
  .hero {
    min-height: 100vh;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 80px 20px 40px;
    position: relative;
    background:
      linear-gradient(180deg, var(--sky) 0%, var(--sky) 60%, var(--grass) 60%, var(--grass-dark) 100%);
  }
  .hero::before {
    content: ''; position: absolute; bottom: 0; left: 0; right: 0;
    height: 40%;
    background-image:
      radial-gradient(circle at 10% 80%, var(--leaf) 8%, transparent 9%),
      radial-gradient(circle at 30% 70%, var(--leaf) 6%, transparent 7%),
      radial-gradient(circle at 70% 85%, var(--leaf) 7%, transparent 8%),
      radial-gradient(circle at 90% 75%, var(--leaf) 6%, transparent 7%);
    opacity: 0.6;
    pointer-events: none;
  }
  .hero-clouds {
    position: absolute; top: 60px; left: 0; right: 0; height: 30%;
    pointer-events: none;
  }
  .cloud {
    position: absolute;
    background: white;
    border-radius: 50%;
    opacity: 0.85;
    box-shadow:
      40px 5px 0 -8px white,
      -40px 5px 0 -8px white,
      0 -15px 0 -10px white;
    animation: drift 30s linear infinite;
  }
  .cloud.c1 { width: 80px; height: 30px; top: 20%; left: -10%; animation-duration: 45s; }
  .cloud.c2 { width: 60px; height: 22px; top: 50%; left: -10%; animation-duration: 60s; animation-delay: -20s; }
  .cloud.c3 { width: 100px; height: 35px; top: 75%; left: -10%; animation-duration: 50s; animation-delay: -35s; }
  @keyframes drift {
    from { transform: translateX(0); }
    to { transform: translateX(120vw); }
  }
  .hero-title {
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 3.6rem);
    color: white;
    text-align: center;
    text-shadow: 4px 4px 0 var(--nook-brown), 0 4px 12px rgba(0,0,0,0.25);
    margin-bottom: 8px;
    line-height: 1.1;
    z-index: 2;
  }
  .hero-subtitle {
    font-family: 'Fredoka', sans-serif;
    font-size: clamp(1rem, 2.4vw, 1.5rem);
    color: white;
    text-shadow: 2px 2px 0 var(--nook-brown);
    margin-bottom: 24px;
    text-align: center;
    z-index: 2;
  }
  .hero-nook {
    width: clamp(180px, 30vw, 280px);
    image-rendering: pixelated;
    image-rendering: -moz-crisp-edges;
    image-rendering: crisp-edges;
    filter: drop-shadow(4px 6px 0 rgba(0,0,0,0.2));
    animation: bobble 2.6s ease-in-out infinite;
    margin-bottom: 18px;
    z-index: 2;
  }
  @keyframes bobble {
    0%, 100% { transform: translateY(0) rotate(-1deg); }
    50% { transform: translateY(-8px) rotate(1deg); }
  }
  .begin-btn {
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    font-size: 1.4rem;
    color: white;
    background: linear-gradient(180deg, #FF8A4C 0%, #E55B1F 100%);
    border: none;
    padding: 16px 36px;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 6px 0 #B8410F, 0 8px 16px rgba(0,0,0,0.2);
    transition: transform 0.12s, box-shadow 0.12s;
    z-index: 2;
    letter-spacing: 0.5px;
  }
  .begin-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 0 #B8410F, 0 10px 20px rgba(0,0,0,0.25); }
  .begin-btn:active { transform: translateY(4px); box-shadow: 0 2px 0 #B8410F; }
  .scroll-hint {
    color: white; margin-top: 28px; font-weight: 600; opacity: 0.9;
    animation: bounce 1.6s ease-in-out infinite;
    z-index: 2;
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }

  /* ----- Lesson section ----- */
  .lesson { padding: 70px 20px 90px; max-width: 880px; margin: 0 auto; }
  .section {
    padding: 36px 28px;
    margin-bottom: 36px;
    background: var(--bubble);
    border-radius: 24px;
    border: 3px solid var(--wood-dark);
    box-shadow: 0 8px 0 var(--wood-dark), 0 10px 24px rgba(61,40,23,0.12);
    position: relative;
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .section.visible { opacity: 1; transform: translateY(0); }
  .section h2 {
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    color: var(--nook-brown);
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    margin-bottom: 18px;
    line-height: 1.15;
    border-bottom: 3px dashed var(--grass);
    padding-bottom: 8px;
  }
  .section h3 {
    font-family: 'Fredoka', sans-serif;
    font-weight: 600;
    color: var(--leaf-dark);
    font-size: 1.3rem;
    margin: 22px 0 10px;
  }
  .section p { margin-bottom: 14px; font-size: 1.07rem; }
  .section ul, .section ol { padding-left: 24px; margin-bottom: 16px; }
  .section li { margin-bottom: 8px; }

  .section .icon-strip {
    display: flex; gap: 14px; flex-wrap: wrap; justify-content: center;
    margin: 18px 0;
  }
  .icon-card {
    flex: 1; min-width: 130px; max-width: 180px;
    background: var(--bg-paper);
    border: 2px solid var(--wood-mid);
    border-radius: 14px;
    padding: 12px;
    text-align: center;
    transition: transform 0.2s;
  }
  .icon-card:hover { transform: translateY(-4px) rotate(-1deg); }
  .icon-card img {
    width: 70px; height: 70px; object-fit: contain;
    background: white; border-radius: 10px; padding: 6px;
  }
  .icon-card .label {
    margin-top: 8px;
    font-family: 'Fredoka', sans-serif;
    font-weight: 600;
    color: var(--nook-brown);
    font-size: 0.95rem;
  }

  /* ----- Clickable keyword ----- */
  .kw {
    background: var(--highlight);
    color: var(--nook-brown);
    padding: 2px 8px;
    border-radius: 6px;
    border-bottom: 2px solid var(--bells-deep);
    cursor: pointer;
    font-weight: 700;
    font-family: 'Fredoka', sans-serif;
    transition: transform 0.1s, background 0.2s;
    display: inline-block;
    white-space: nowrap;
    user-select: none;
  }
  .kw::before {
    content: '✦ ';
    color: var(--bells-deep);
    font-size: 0.85em;
  }
  .kw:hover { background: #FFE066; transform: scale(1.04); }
  .kw:active { transform: scale(0.95); }
  .kw.learned { background: var(--leaf); border-bottom-color: var(--leaf-dark); }
  .kw.learned::before { content: '✓ '; color: var(--leaf-dark); }

  /* ----- Callout boxes ----- */
  .nook-tip {
    display: flex; gap: 14px; align-items: flex-start;
    background: linear-gradient(135deg, #FFF6D8 0%, #FFE8A8 100%);
    border-left: 6px solid var(--bells);
    border-radius: 12px;
    padding: 14px 16px;
    margin: 18px 0;
    box-shadow: 0 3px 8px rgba(0,0,0,0.08);
  }
  .nook-tip .mini-nook {
    width: 52px; height: 52px; flex-shrink: 0;
    image-rendering: pixelated;
  }
  .nook-tip .tip-text {
    flex: 1;
    font-size: 1rem;
    color: var(--text);
  }
  .nook-tip .tip-text strong { color: var(--nook-brown); }

  .mnemonic-card {
    background: linear-gradient(135deg, #E1F5C4 0%, #B5E089 100%);
    border: 3px solid var(--leaf-dark);
    border-radius: 16px;
    padding: 18px;
    margin: 24px 0;
    text-align: center;
    box-shadow: 0 5px 0 var(--leaf-dark);
  }
  .mnemonic-card .mn-label {
    font-family: 'Press Start 2P', monospace;
    font-size: 0.7rem;
    color: var(--leaf-dark);
    letter-spacing: 1px;
    margin-bottom: 8px;
  }
  .mnemonic-card .mn-phrase {
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    font-size: clamp(1.2rem, 3vw, 1.7rem);
    color: var(--nook-brown);
    line-height: 1.2;
  }
  .mnemonic-card .mn-phrase em {
    background: white;
    padding: 2px 10px;
    border-radius: 6px;
    font-style: normal;
    border: 2px solid var(--leaf-dark);
  }

  .think-box {
    background: var(--sky);
    border: 3px dashed var(--sky-deep);
    border-radius: 14px;
    padding: 14px 18px;
    margin: 18px 0;
  }
  .think-box .label {
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    color: #2A5F7C;
    font-size: 0.95rem;
    margin-bottom: 4px;
  }

  .challenge-word {
    background: linear-gradient(135deg, #FFD8E3 0%, #FFB7C5 100%);
    border: 3px solid #D86A8E;
    border-radius: 18px;
    padding: 18px 22px;
    margin: 22px 0;
    position: relative;
  }
  .challenge-word .stamp {
    position: absolute; top: -14px; right: 18px;
    background: #D86A8E; color: white;
    font-family: 'Press Start 2P', monospace;
    font-size: 0.6rem;
    padding: 5px 9px;
    border-radius: 6px;
    letter-spacing: 1px;
  }
  .challenge-word h4 {
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    color: #8B2147;
    font-size: 1.25rem;
    margin-bottom: 8px;
  }

  /* ----- Mini quick-check ----- */
  .quick-check {
    background: #FFF6D8;
    border: 3px solid var(--bells-deep);
    border-radius: 16px;
    padding: 16px 20px;
    margin: 20px 0;
  }
  .quick-check .qc-label {
    font-family: 'Press Start 2P', monospace;
    font-size: 0.65rem;
    color: var(--bells-deep);
    margin-bottom: 8px;
    letter-spacing: 1px;
  }
  .quick-check .qc-question { font-weight: 600; margin-bottom: 10px; font-size: 1.05rem; }
  .quick-check .qc-options { display: flex; flex-wrap: wrap; gap: 8px; }
  .quick-check button {
    font-family: 'Fredoka', sans-serif;
    font-weight: 600;
    background: white;
    border: 2px solid var(--wood-dark);
    border-radius: 999px;
    padding: 8px 16px;
    cursor: pointer;
    transition: all 0.15s;
    color: var(--text);
  }
  .quick-check button:hover { background: var(--hint); }
  .quick-check button.correct {
    background: var(--ok); color: white; border-color: #2E7D32;
  }
  .quick-check button.wrong {
    background: var(--bad); color: white; border-color: #B71C1C;
  }
  .qc-feedback { margin-top: 8px; font-weight: 600; }
  .qc-feedback.ok { color: #2E7D32; }
  .qc-feedback.no { color: #B71C1C; }

  /* ----- Image embed ----- */
  .embed-image {
    display: block;
    max-width: 100%;
    border-radius: 14px;
    margin: 14px auto;
    border: 3px solid var(--wood-mid);
    background: white;
  }
  .image-caption {
    text-align: center; font-style: italic; color: var(--text-soft);
    font-size: 0.92rem; margin-top: -6px; margin-bottom: 16px;
  }

  /* ----- Dialogue box (fixed at bottom) ----- */
  .nook-dialogue {
    position: fixed;
    bottom: 14px; right: 14px;
    width: min(360px, calc(100% - 28px));
    background: var(--bubble);
    border: 3px solid var(--nook-brown);
    border-radius: 18px;
    padding: 12px 14px 12px 64px;
    box-shadow: 0 6px 18px rgba(0,0,0,0.2);
    z-index: 90;
    transition: transform 0.3s ease, opacity 0.3s ease;
    cursor: pointer;
  }
  .nook-dialogue.hidden { transform: translateY(140%); opacity: 0; }
  .nook-dialogue .nook-sprite {
    position: absolute;
    left: -10px; bottom: -8px;
    width: 78px; height: 78px;
    image-rendering: pixelated;
    filter: drop-shadow(2px 3px 0 rgba(0,0,0,0.15));
  }
  .nook-dialogue .dialogue-text {
    font-family: 'Nunito', sans-serif;
    font-size: 0.98rem;
    color: var(--text);
    min-height: 2.4em;
    font-weight: 600;
  }
  .nook-dialogue .dialogue-name {
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    color: var(--nook-brown);
    font-size: 0.85rem;
    margin-bottom: 2px;
  }
  .nook-dialogue .blink {
    display: inline-block;
    width: 10px; height: 14px;
    background: var(--nook-brown);
    margin-left: 2px;
    vertical-align: middle;
    animation: blink 0.8s steps(2) infinite;
  }
  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
  .nook-dialogue .close-d {
    position: absolute;
    top: 4px; right: 8px;
    background: none; border: none;
    font-size: 1.1rem;
    color: var(--text-soft);
    cursor: pointer;
    line-height: 1;
  }
  .nook-dialogue .tap-hint {
    font-size: 0.75rem;
    color: var(--text-soft);
    text-align: right;
    margin-top: 4px;
    font-style: italic;
  }

  /* ----- Definition modal ----- */
  .modal-backdrop {
    position: fixed; inset: 0;
    background: rgba(61, 40, 23, 0.55);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 200;
    padding: 20px;
    backdrop-filter: blur(3px);
  }
  .modal-backdrop.active { display: flex; }
  .modal {
    background: var(--bubble);
    border: 4px solid var(--nook-brown);
    border-radius: 22px;
    padding: 28px 28px 24px;
    max-width: 460px;
    width: 100%;
    position: relative;
    box-shadow: 0 12px 30px rgba(0,0,0,0.3);
    animation: pop 0.25s ease-out;
  }
  @keyframes pop {
    from { transform: scale(0.85); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  .modal .modal-tag {
    position: absolute; top: -18px; left: 22px;
    background: var(--bells);
    color: var(--nook-brown);
    font-family: 'Press Start 2P', monospace;
    font-size: 0.65rem;
    padding: 6px 12px;
    border-radius: 8px;
    border: 2px solid var(--bells-deep);
    letter-spacing: 1px;
  }
  .modal h3 {
    font-family: 'Fredoka', sans-serif;
    color: var(--nook-brown);
    font-size: 1.5rem;
    margin-bottom: 10px;
  }
  .modal p { font-size: 1.05rem; margin-bottom: 14px; }
  .modal .nook-says {
    background: var(--leaf);
    border-left: 4px solid var(--leaf-dark);
    padding: 10px 12px;
    border-radius: 8px;
    font-style: italic;
    color: var(--leaf-dark);
    margin-bottom: 16px;
    font-weight: 600;
  }
  .modal .close-modal {
    background: var(--grass-dark);
    color: white;
    border: none;
    padding: 10px 20px;
    font-family: 'Fredoka', sans-serif;
    font-weight: 600;
    font-size: 1rem;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 3px 0 var(--leaf-dark);
    transition: transform 0.1s;
  }
  .modal .close-modal:active { transform: translateY(2px); box-shadow: 0 1px 0 var(--leaf-dark); }

  /* ----- Achievement toast ----- */
  .ach-toast {
    position: fixed;
    top: 70px; left: 50%;
    transform: translateX(-50%) translateY(-200%);
    background: linear-gradient(180deg, var(--bells) 0%, var(--bells-deep) 100%);
    border: 3px solid var(--nook-brown);
    border-radius: 14px;
    padding: 10px 18px;
    z-index: 150;
    box-shadow: 0 6px 16px rgba(0,0,0,0.25);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    color: var(--nook-brown);
    display: flex; align-items: center; gap: 10px;
    max-width: 90%;
  }
  .ach-toast.show { transform: translateX(-50%) translateY(0); }
  .ach-toast .ach-icon { font-size: 1.5rem; }

  /* ----- Quiz section ----- */
  .quiz-intro {
    background: linear-gradient(135deg, var(--nook-brown) 0%, var(--wood-dark) 100%);
    color: white;
    border-radius: 24px;
    padding: 36px 28px;
    text-align: center;
    margin-bottom: 30px;
    box-shadow: 0 8px 0 #4A2E15, 0 10px 24px rgba(0,0,0,0.2);
  }
  .quiz-intro h2 {
    font-family: 'Fredoka', sans-serif;
    color: var(--bells);
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    margin-bottom: 12px;
    text-shadow: 2px 2px 0 rgba(0,0,0,0.3);
  }
  .quiz-intro p { font-size: 1.1rem; margin-bottom: 8px; }

  .quiz-card {
    background: var(--bubble);
    border: 3px solid var(--wood-dark);
    border-radius: 20px;
    padding: 22px 24px;
    margin-bottom: 22px;
    box-shadow: 0 6px 0 var(--wood-dark);
    position: relative;
  }
  .quiz-card .q-num {
    position: absolute;
    top: -12px; left: 18px;
    background: var(--grass-dark);
    color: white;
    font-family: 'Press Start 2P', monospace;
    font-size: 0.65rem;
    padding: 6px 10px;
    border-radius: 6px;
    letter-spacing: 1px;
  }
  .quiz-card .q-type {
    position: absolute;
    top: -12px; right: 18px;
    background: var(--bells);
    color: var(--nook-brown);
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    font-size: 0.75rem;
    padding: 5px 10px;
    border-radius: 6px;
    border: 2px solid var(--bells-deep);
  }
  .quiz-card .q-prompt {
    font-weight: 700;
    font-size: 1.1rem;
    margin: 8px 0 14px;
    color: var(--text);
  }
  .quiz-card .q-options { display: flex; flex-direction: column; gap: 8px; }
  .quiz-card .q-options.tf { flex-direction: row; gap: 12px; }
  .quiz-card .q-option {
    font-family: 'Nunito', sans-serif;
    font-weight: 600;
