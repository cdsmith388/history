  .matching .m-item.matched-2 { background: #BBDEFB; border-color: #1976D2; }
  .matching .m-item.matched-3 { background: #F8BBD0; border-color: #C2185B; }
  .matching .m-item.matched-4 { background: #FFE082; border-color: #F57F17; }
  .matching .m-item.matched-5 { background: #D7CCC8; border-color: #5D4037; }
  .matching .m-item.matched-6 { background: #B2EBF2; border-color: #00838F; }
  .matching .m-item .pair-tag {
    display: inline-block;
    background: rgba(0,0,0,0.15);
