  }
  .reflection .submit-reflect:active {
    transform: translateY(3px); box-shadow: 0 1px 0 #B8410F;
  }
  .reflection .reflect-feedback {
    margin-top: 14px;
    padding: 14px;
    border-radius: 12px;
    background: var(--leaf);
    color: var(--leaf-dark);
    font-weight: 600;
    display: none;
  }
  .reflection .reflect-feedback.show { display: block; }

  /* ----- Outro / Certificate ----- */
  .outro {
    background: linear-gradient(180deg, #FFF6D8 0%, #FFE8A8 100%);
    border: 4px solid var(--bells-deep);
    border-radius: 24px;
