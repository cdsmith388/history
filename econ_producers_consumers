    text-align: center;
    margin: 40px 0;
    display: none;
    box-shadow: 0 8px 0 var(--bells-deep);
  }
  .outro.show { display: block; animation: pop 0.5s ease-out; }
  .outro h2 {
    font-family: 'Fredoka', sans-serif;
    color: var(--nook-brown);
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    margin-bottom: 12px;
  }
  .outro .cert-nook {
    width: 200px;
    image-rendering: pixelated;
    margin: 18px auto;
    display: block;
    animation: bobble 2.4s ease-in-out infinite;
  }
  .outro .cert-line {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.15rem;
    color: var(--nook-brown);
    margin: 8px 0;
  }
  .outro .restart-btn {
    background: var(--grass-dark);
