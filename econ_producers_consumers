    text-align: center; line-height: 22px;
    margin-right: 6px;
    font-size: 0.8rem;
  }

  /* ----- Word bank ----- */
  .word-bank {
    background: linear-gradient(180deg, #FFF8E7 0%, #FFE8A8 100%);
    border: 2px dashed var(--bells-deep);
    border-radius: 14px;
    padding: 12px;
    margin: 14px 0;
    display: flex; flex-wrap: wrap; gap: 8px;
    justify-content: center;
  }
  .word-bank .word-chip {
    background: white;
    border: 2px solid var(--nook-brown);
    border-radius: 999px;
    padding: 4px 12px;
    font-family: 'Fredoka', sans-serif;
    font-weight: 600;
    color: var(--nook-brown);
    font-size: 0.95rem;
  }
  .word-bank-label {
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    color: var(--bells-deep);
    text-align: center;
    width: 100%;
    margin-bottom: 4px;
    font-size: 0.85rem;
    letter-spacing: 1px;
  }

  /* ----- Score / Reflection ----- */
  .score-box {
    background: linear-gradient(135deg, var(--grass) 0%, var(--grass-dark) 100%);
    color: white;
    border-radius: 24px;
    padding: 36px 28px;
    text-align: center;
    margin: 30px 0;
    box-shadow: 0 8px 0 var(--leaf-dark);
    display: none;
  }
  .score-box.show { display: block; }
  .score-box h2 { font-family: 'Fredoka', sans-serif; font-size: 2rem; margin-bottom: 14px; }
  .score-circle {
    width: 140px; height: 140px;
