// ── NAVIGATION ───────────────────────────────────────────────
function render(){
  const s=SECTS[cur];
  document.getElementById('pgTitle').textContent=s.lbl==='Start'?'The Later 2000s':s.lbl;
  const bk=document.getElementById('bkBtn');
  bk.style.visibility=cur===0?'hidden':'visible';
  document.getElementById('pvBtn').disabled=cur===0;
  const nx=document.getElementById('nxBtn');
  nx.disabled=cur===SECTS.length-1;
  nx.textContent=cur===SECTS.length-2?'Quiz ▶':'Next ▶';

  const dotsEl=document.getElementById('dots');
  dotsEl.innerHTML=SECTS.map((_,i)=>`<div class="ndot ${i===cur?'on':''}" onclick="goTo(${i})"></div>`).join('');

  const ca=document.getElementById('carea');
  const builds=[buildCover,buildCh1,buildCh2,buildCh3,buildCh4,buildCh5,buildQuiz];
  ca.innerHTML=builds[cur]();
  ca.scrollTop=0;
}

function goFwd(){if(cur<SECTS.length-1){cur++;render();}}
function goBack(){if(cur>0){cur--;render();}}
function goTo(i){cur=i;render();}
function goHome(){cur=0;render();}

// ── DEFINITIONS ──────────────────────────────────────────────
function showDef(k){
  if(!D[k])return;
  document.getElementById('aTerm').textContent=k;
  document.getElementById('aDef').textContent=D[k];
  document.getElementById('mover').classList.add('on');
}
function closeDef(){document.getElementById('mover').classList.remove('on');}

// ── QUICK CHECKS ─────────────────────────────────────────────
function aQC(id,el,ok){
  const p=document.getElementById(id);
  p.querySelectorAll('.qopt').forEach(o=>o.onclick=null);
  el.classList.add(ok?'ok':'no');
  el.querySelector('.qlet').textContent=ok?'✓':'✗';
  const fb=document.getElementById(id+'-fb');
  fb.textContent=ok?'✓ Correct! Well done.':'✗ Not quite — review the text above for the answer.';
  fb.className='qfb show '+(ok?'ok':'no');
}

// ── QUIZ: FILL IN BLANK ──────────────────────────────────────
function ckFB(i){
  document.getElementById('fbB'+i).disabled=!document.getElementById('fb'+i).value.trim();
}
function subFB(i){
  if(ans.fb[i]!==undefined)return;
  const v=document.getElementById('fb'+i).value.trim().toLowerCase().replace(/\./g,'');
  const a=FB[i].a.toLowerCase();
  const ok=v===a||v.includes(a)||(a.includes(' ')&&v.split(' ').some(w=>a.includes(w)&&w.length>3));
  ans.fb[i]=ok;
  if(ok)sc.fb++;
  const fb=document.getElementById('fbR'+i);
  fb.textContent=ok?`✓ Correct! The answer is "${FB[i].a}."`:`✗ The correct answer is "${FB[i].a}."`;
  fb.className='ifb show '+(ok?'ok':'no');
  document.getElementById('fbB'+i).disabled=true;
  document.getElementById('fb'+i).disabled=true;
  updProg();
}

// ── QUIZ: TRUE/FALSE ─────────────────────────────────────────
function subTF(i,v){
  if(ans.tf[i]!==undefined)return;
  const ok=v===TF[i].a;
  ans.tf[i]=ok;
  if(ok)sc.tf++;
  const tB=document.getElementById('tfT'+i),fB=document.getElementById('tfF'+i);
  tB.disabled=true;fB.disabled=true;
  (v?tB:fB).classList.add(v?'st':'sf');
  const fb=document.getElementById('tfR'+i);
  let msg=ok?'✓ Correct!':'✗ Incorrect.';
  if(!ok&&TF[i].ex)msg+=' '+TF[i].ex;
  fb.textContent=msg;fb.className='ifb show '+(ok?'ok':'no');
  updProg();
}

// ── QUIZ: MULTIPLE CHOICE ────────────────────────────────────
function subMC(i,j){
  if(ans.mc[i]!==undefined)return;
  const ok=j===MC[i].a;
  ans.mc[i]=ok;
  if(ok)sc.mc++;
  for(let k=0;k<MC[i].o.length;k++){
    const el=document.getElementById('mc'+i+'_'+k);
    el.classList.add('lk');el.onclick=null;
    if(k===MC[i].a)el.classList.add('ok');
    else if(k===j)el.classList.add('no');
  }
  const fb=document.getElementById('mcR'+i);
  fb.textContent=ok?'✓ Correct!':'✗ Incorrect. The correct answer is highlighted above.';
  fb.className='ifb show '+(ok?'ok':'no');
  updProg();
}

// ── QUIZ: MATCHING ───────────────────────────────────────────
function selT(i){
  if(document.getElementById('mT'+i).classList.contains('mat'))return;
  document.querySelectorAll('.mterm').forEach(b=>{if(!b.classList.contains('mat'))b.classList.remove('sel');});
  selTerm=i;
  document.getElementById('mT'+i).classList.add('sel');
}
function selD(origIdx,dispIdx){
  const dEl=document.getElementById('mD'+dispIdx);
  if(dEl.classList.contains('mat'))return;
  if(selTerm===null)return;
  const ok=origIdx===selTerm;
  document.getElementById('mT'+selTerm).classList.remove('sel');
  if(ok){
    document.getElementById('mT'+selTerm).classList.add('mat');
    dEl.classList.add('mat');
    mtPairs.push(selTerm);
    sc.mt++;
    if(mtPairs.length===MP.length){
      const fb=document.getElementById('mtFb');
      fb.textContent='✓ All pairs matched correctly! Excellent work.';
      fb.className='ifb show ok';
    }
  } else {
    document.getElementById('mT'+selTerm).classList.add('wrg');
    dEl.classList.add('wrg');
    const fb=document.getElementById('mtFb');
    fb.textContent='✗ Not a match. Try again!';
    fb.className='ifb show no';
    setTimeout(()=>{
      document.getElementById('mT'+selTerm).classList.remove('wrg');
      dEl.classList.remove('wrg');
      fb.className='ifb';
    },900);
  }
  selTerm=null;
  updProg();
}

function updProg(){
  const done=ans.fb.length+ans.tf.length+ans.mc.length+mtPairs.length;
  const total=5+10+10+MP.length;
  const el=document.getElementById('qprog');
  if(el)el.style.width=(done/total*100)+'%';
}

function subQuiz(){
  const total=sc.fb+sc.tf+sc.mc+sc.mt;
  document.getElementById('sNum').textContent=total;
  document.getElementById('sFB').textContent=sc.fb+' / 5';
  document.getElementById('sTF').textContent=sc.tf+' / 10';
  document.getElementById('sMC').textContent=sc.mc+' / 10';
  document.getElementById('sMT').textContent=sc.mt+' / '+MP.length;
  const scr=document.getElementById('scrSec');
  scr.style.display='block';
  const ca=document.getElementById('carea');
  setTimeout(()=>{ca.scrollTop=scr.offsetTop;},200);
}

// ── CLOCK ────────────────────────────────────────────────────
function updateClock(){
  const n=new Date();
  let h=n.getHours(),m=n.getMinutes();
  const ap=h>=12?'PM':'AM';h=h%12||12;
  document.getElementById('clk').textContent=h+':'+(m<10?'0':'')+m+' '+ap;
}

// ── INIT ─────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded',()=>{
  const sd=document.getElementById('spDots');
  for(let i=0;i<28;i++){const d=document.createElement('div');d.className='sp-dot';sd.appendChild(d);}
  updateClock();
  setInterval(updateClock,30000);
  render();
});
</script>
