      <div class="quiz-qtext">The Department of <input class="fib-blank" id="fib3" placeholder="type answer"> Security was created in 2002 by combining 22 federal agencies.</div>
      <div class="fib-hint" id="fib3h"></div>
    </div>
    <div class="quiz-q">
      <div class="quiz-qnum">Question 4 of 5</div>
      <div class="quiz-qtext">Apple launched the <input class="fib-blank" id="fib4" placeholder="type answer"> in October 2001, a device capable of holding up to 1,000 songs in your pocket.</div>
      <div class="fib-hint" id="fib4h"></div>
    </div>
    <div class="quiz-q">
      <div class="quiz-qnum">Question 5 of 5</div>
      <div class="quiz-qtext">The Human <input class="fib-blank" id="fib5" placeholder="type answer"> Project, completed in 2003, produced a reference sequence of human DNA two years ahead of schedule.</div>
      <div class="fib-hint" id="fib5h"></div>
    </div>
    <button class="check-btn" onclick="checkFIB()">Check Answers</button>
    <span class="score-badge" id="fibScore" style="display:none"></span>
  </div>

  <!-- TRUE FALSE -->
  <div class="quiz-body quiz-panel" id="tab1">
    <div id="tfqs"></div>
    <button class="check-btn" onclick="checkTF()">Check Answers</button>
    <span class="score-badge" id="tfScore" style="display:none"></span>
  </div>

  <!-- MULTIPLE CHOICE -->
  <div class="quiz-body quiz-panel" id="tab2">
    <div id="mcqs"></div>
    <button class="check-btn" onclick="checkMC()">Check Answers</button>
    <span class="score-badge" id="mcScore" style="display:none"></span>
  </div>

  <!-- MATCHING -->
  <div class="quiz-body quiz-panel" id="tab3">
    <p style="font-size:15px;color:#3a3a3c;margin-bottom:20px;">Match each term to its correct description by selecting from the dropdown menus.</p>
    <div id="matchqs"></div>
    <button class="check-btn" onclick="checkMatch()">Check Answers</button>
    <span class="score-badge" id="matchScore" style="display:none"></span>
  </div>

  <!-- ESSAY -->
  <div class="quiz-body quiz-panel" id="tab4">
    <div class="quiz-q" style="border:none;padding:0;margin:0">
      <div class="quiz-qnum">Essay Prompt</div>
      <div class="quiz-qtext">The early 2000s have been described as a decade that "shattered one world and built another at the same time." Using at least <strong>three specific events or developments</strong> from this unit, explain how the era was defined by both loss and rapid change. How do the events of this period continue to shape life in America today? Aim for 2–3 well-developed paragraphs.</div>
      <textarea class="essay-area" id="essayText" placeholder="Write your essay response here..." oninput="updateWC()"></textarea>
      <div class="word-count" id="wcDisplay">0 words</div>
      <div style="margin-top:16px;background:#f5f5f7;border-radius:12px;padding:16px;font-size:14px;color:#3a3a3c">
        <strong>Scoring Checklist:</strong> Does your essay (1) identify and explain at least three events? (2) connect each event to the theme of loss or change? (3) address how these events still matter today? (4) use specific names and dates — not just general statements?
      </div>
    </div>
  </div>
</div>
</div>

<!-- MODAL -->
<div class="modal-overlay" id="modalOverlay" onclick="closeModal(event)">
  <div class="modal" role="dialog" aria-modal="true">
    <div class="modal-label">Vocabulary</div>
    <div class="modal-term" id="modalTerm"></div>
    <div class="modal-def" id="modalDef"></div>
    <button class="modal-close" onclick="closeModal()">Got it</button>
  </div>
</div>

<footer class="footer">
  <div class="footer-wheel"></div>
  <p>The Early 2000s: The Bright Screen &amp; the Burning Skyline</p>
  <p style="margin-top:8px;font-size:11px;opacity:0.6">Educational Module · All rights reserved · Images used for educational purposes</p>
</footer>

<script>
const IMGS = {
  i1: "data:image/jpeg;base64,",
  i2: "data:image/jpeg;base64,",
  i3: "data:image/jpeg;base64,",
  i4: "data:image/jpeg;base64,",
  i5: "data:image/jpeg;base64,",
  i6: "data:image/jpeg;base64,",
  i7: "data:image/jpeg;base64,",
  i8: "data:image/jpeg;base64,",
  i9: "data:image/jpeg;base64,",
  i10: "data:image/jpeg;base64,",
  i11: "data:image/jpeg;base64,",
  i12: "data:image/jpeg;base64,",
  i13: "data:image/jpeg;base64,",
  i14: "data:image/jpeg;base64,",
  i15: "data:image/jpeg;base64,",
  i16: "data:image/jpeg;base64,",
};

// Load images
document.querySelectorAll("img[data-src]").forEach(img => {
  const key = img.getAttribute("data-src");
  if (IMGS[key]) img.src = IMGS[key];
});

// Progress bar
window.addEventListener("scroll", () => {
  const d = document.documentElement;
  const pct = (d.scrollTop / (d.scrollHeight - d.clientHeight)) * 100;
  document.getElementById("prog").style.width = pct + "%";
});

// Active nav link
const secIds = ["p1","p2","p3","p4","p5","quiz"];
window.addEventListener("scroll", () => {
  let cur = "";
  secIds.forEach(id => {
    const el = document.getElementById(id);
    if (el && window.scrollY >= el.offsetTop - 100) cur = id;
  });
  document.querySelectorAll(".toc-link").forEach(a => {
    a.classList.toggle("active", a.getAttribute("href") === "#" + cur);
  });
});

// Glossary
const GLOSSARY = {
  bush: ["George W. Bush","Republican presidential candidate in 2000; 43rd U.S. President and governor of Texas. Son of the 41st president, George H.W. Bush."],
  gore: ["Al Gore","Democratic presidential candidate in 2000; served as Vice President under President Bill Clinton for two terms."],
  bushvgore: ["Bush v. Gore","A 2000 U.S. Supreme Court case that stopped the Florida recount, effectively awarding Florida's electoral votes to Bush and making him president."],
  dotcom: ["Dot-com Bubble","A rapid rise and then collapse in the value of internet-based companies in the late 1990s and early 2000s, caused by excessive investment in businesses that were not profitable."],
  nasdaq: ["Nasdaq","A major U.S. stock exchange known for technology companies. Its index fell sharply after the dot-com bubble burst in 2000, losing much of its peak value."],
  petscom: ["Pets.com","An online pet supply retailer that became the most famous symbol of dot-com era overconfidence. It raised millions from investors then collapsed in 2000."],
  realitytv: ["Reality TV","A television genre featuring unscripted scenarios with real or semi-real people placed in contests, houses, or challenging situations — edited to maximize drama."],
  survivor: ["Survivor","A reality TV competition that premiered in the U.S. in 2000. Contestants compete in challenges and vote each other out. It launched the modern reality TV era."],
  terrorism: ["Terrorism","Violence or threats of violence against civilians or governments, used to create fear and force political or ideological change."],
  wot: ["War on Terror","A broad U.S.-led military and political campaign launched after 9/11 to combat al-Qaeda and other terrorist groups, plus governments accused of supporting them."],
  alqaeda: ["Al-Qaeda","An extremist Islamist terrorist organization, founded by Osama bin Laden, responsible for planning and executing the September 11, 2001 attacks."],
  taliban: ["Taliban","A fundamentalist Islamic political and military movement that governed Afghanistan from 1996 until 2001. They provided shelter to al-Qaeda before the U.S. invasion."],
  "911comm": ["9/11 Commission","A bipartisan government commission created to investigate the September 11 attacks, their causes, preparedness failures, and the U.S. response. Its final report was released in 2004."],
  patriot: ["USA PATRIOT Act","A law passed in October 2001 that greatly expanded U.S. government surveillance powers, intelligence sharing, and law enforcement authority in the name of fighting terrorism."],
  afghan: ["Afghanistan","A country in Central Asia invaded by the U.S. and allies in October 2001 after the Taliban government refused to hand over al-Qaeda leader Osama bin Laden."],
  hsa: ["Homeland Security Act","A 2002 law signed by President Bush that created the Department of Homeland Security — the largest reorganization of the U.S. federal government since World War II."],
  dhs: ["Department of Homeland Security","A federal cabinet department created in 2002 to coordinate domestic security, border control, emergency management, and terrorism prevention by merging 22 agencies."],
  iraq: ["Iraq War","A U.S.-led military campaign beginning in March 2003 to remove Saddam Hussein from power, justified by claims of weapons of mass destruction. It lasted over eight years."],
  saddam: ["Saddam Hussein","Dictator of Iraq from 1979 until he was removed from power during the 2003 U.S. invasion. He was later tried and executed by the Iraqi government in 2006."],
  enron: ["Enron","A once-powerful American energy company that collapsed in 2001 after its executives were discovered to have committed massive accounting fraud, hiding billions in debt from investors."],
  ps2: ["PlayStation 2","A Sony gaming console released in 2000 that became one of the best-selling game systems of all time. It also played DVDs, making it a full home entertainment device."],
  wiki: ["Wikipedia","A free, online encyclopedia launched in January 2001 that is written and edited by volunteers worldwide. It created a new model for collaborative, open-access knowledge."],
  ipod: ["iPod","Apple's portable digital music player introduced in October 2001. It could hold up to 1,000 CD-quality songs and became a cultural icon of the early 2000s."],
  itunes: ["iTunes Music Store","Apple's online music retail platform launched in April 2003. It sold individual songs for 99 cents each, creating a legal alternative to illegal music downloading."],
  napster: ["Napster","A peer-to-peer file-sharing service launched in 1999 that allowed users to share music files for free over the internet. It was shut down after losing major copyright lawsuits."],
  myspace: ["MySpace","A social networking website launched in 2003. It became the most popular social network in the world for a period, particularly known for music profiles and youth culture."],
  facebook: ["Facebook","A social networking site launched in February 2004 by Harvard student Mark Zuckerberg. It began as a college-only network and expanded into a global platform."],
  idol: ["American Idol","A reality TV singing competition that premiered in the U.S. in June 2002. Viewers voted for their favorite contestants, turning the audition process itself into national entertainment."],
  kelly: ["Kelly Clarkson","The winner of the first season of American Idol in 2002. She went on to become a major recording artist and pop star, demonstrating the show's ability to launch real careers."],
  hgp: ["Human Genome Project","An international scientific collaboration completed in April 2003 that produced a reference sequence of all human DNA — the complete genetic instructions for building a human being."],
  genome: ["Genome","The complete set of genetic instructions (DNA) found in a living organism. The human genome contains roughly 3 billion base pairs of DNA organized into 23 pairs of chromosomes."],
  kerry: ["John Kerry","The Democratic presidential candidate in the 2004 election. Kerry, a U.S. Senator and Vietnam War veteran, lost to incumbent President George W. Bush."]
};

document.querySelectorAll(".kw").forEach(el => {
  el.addEventListener("click", () => {
    const key = el.getAttribute("data-term");
    const data = GLOSSARY[key];
    if (!data) return;
    document.getElementById("modalTerm").textContent = data[0];
    document.getElementById("modalDef").textContent = data[1];
    document.getElementById("modalOverlay").classList.add("open");
  });
});

function closeModal(e) {
  if (!e || e.target === document.getElementById("modalOverlay"))
    document.getElementById("modalOverlay").classList.remove("open");
}

// Quick check
function checkQC(el, correct) {
  const parent = el.closest(".qc-question");
  if (parent.querySelector(".correct, .wrong")) return;
  parent.querySelectorAll(".qc-opt").forEach(o => o.style.pointerEvents = "none");
  el.classList.add(correct ? "correct" : "wrong");
  const fb = parent.querySelector(".qc-feedback");
  fb.style.color = correct ? "#1a5c2a" : "#c0392b";
  fb.textContent = correct ? "✓ Correct!" : "✗ Not quite — review the chapter and try again.";
}

// Tabs
function switchTab(i) {
  document.querySelectorAll(".quiz-tab").forEach((t,j) => t.classList.toggle("active", i===j));
  document.querySelectorAll(".quiz-panel").forEach((p,j) => p.classList.toggle("active", i===j));
}

// T/F data
const TF = [
  ["Al Gore won the Electoral College in the 2000 election.", false],
  ["The Nasdaq technology index peaked in March 2000 before crashing.", true],
  ["The September 11 attacks were carried out by al-Qaeda.", true],
  ["United Flight 93, the fourth hijacked plane, struck the White House.", false],
  ["The USA PATRIOT Act was passed in October 2001.", true],
  ["The Department of Homeland Security combined 22 federal agencies into one.", true],
  ["Weapons of mass destruction were found in Iraq following the 2003 invasion.", false],
  ["Wikipedia was designed to be written and edited only by certified experts.", false],
  ["Kelly Clarkson won the first season of American Idol.", true],
  ["The Human Genome Project was completed more than two years ahead of schedule.", true]
];

// MC data
const MC = [
  {q:"Who ran against George W. Bush in the 2000 presidential election?",opts:["Bill Clinton","Al Gore","John Kerry","Barack Obama"],a:1},
  {q:"Which company became the most famous symbol of dot-com overconfidence after collapsing in 2000?",opts:["Amazon","Napster","Pets.com","MySpace"],a:2},
  {q:"Which government sheltered al-Qaeda in Afghanistan before the September 11 attacks?",opts:["The Taliban","Saddam Hussein's regime","The Iraqi Republican Guard","Hamas"],a:0},
  {q:"The USA PATRIOT Act primarily expanded government powers in which area?",opts:["Environmental regulation","Trade policy","Surveillance and intelligence gathering","Immigration limits"],a:2},
  {q:"What was the main stated justification for the 2003 U.S. invasion of Iraq?",opts:["Al-Qaeda headquarters in Baghdad","Control of oil reserves","Weapons of mass destruction","Human rights violations"],a:2},
  {q:"The PlayStation 2, launched in 2000, was notable for also being able to do what?",opts:["Connect to the internet","Play DVDs","Record television","Run Windows software"],a:1},
  {q:"In what year did Apple open the iTunes Music Store?",opts:["2001","2002","2003","2004"],a:2},
  {q:"What was Facebook originally called when Mark Zuckerberg launched it in 2004?",opts:["TheFace","thefacebook","FaceNet","BookFace"],a:1},
  {q:"Who won the 2004 presidential election against John Kerry?",opts:["Al Gore","George W. Bush","Dick Cheney","Colin Powell"],a:1},
  {q:"A genome is best defined as which of the following?",opts:["A type of computer virus","An early internet search engine","The complete set of genetic instructions in a living thing","A form of nuclear weapon"],a:2}
];

// Matching data
const MATCH_TERMS = ["Enron","Wikipedia","Napster","9/11 Commission","MySpace"];
const MATCH_DEFS = [
  "A peer-to-peer file sharing service that allowed free music downloads, sparking copyright battles",
  "A social networking site launched in 2003, popular with music fans and youth culture",
  "An energy company that collapsed in 2001 due to massive accounting fraud and hidden debt",
  "A volunteer-written and edited free online encyclopedia launched in 2001",
  "A bipartisan group created to investigate the September 11, 2001 attacks and U.S. response"
];
const MATCH_ANS = [2, 3, 0, 4, 1]; // MATCH_TERMS[i] matches MATCH_DEFS[MATCH_ANS[i]]

// Build TF
const tfContainer = document.getElementById("tfqs");
TF.forEach((item, i) => {
  const div = document.createElement("div");
  div.className = "quiz-q";
  div.innerHTML = `<div class="quiz-qnum">Question ${i+1} of 10</div>
    <div class="quiz-qtext">${item[0]}</div>
    <div class="tf-opts">
      <button class="tf-btn" data-q="${i}" data-v="true" onclick="pickTF(this,${item[1]},true)">True</button>
      <button class="tf-btn" data-q="${i}" data-v="false" onclick="pickTF(this,${item[1]},false)">False</button>
    </div>
    <div class="fib-hint" id="tfh${i}"></div>`;
  tfContainer.appendChild(div);
});

function pickTF(el, correct, isTrue) {
  const q = el.getAttribute("data-q");
  const parent = el.closest(".quiz-q");
  if (parent.querySelector(".correct,.wrong")) return;
  const chosen = isTrue;
  const right = (chosen === correct);
  el.classList.add(right ? "correct" : "wrong");
  parent.querySelectorAll(".tf-btn").forEach(b => b.style.pointerEvents="none");
  const h = document.getElementById("tfh"+q);
  h.style.color = right ? "#1a5c2a" : "#c0392b";
  h.textContent = right ? "✓ Correct!" : `✗ The correct answer is: ${correct ? "True" : "False"}`;
}

// Build MC
const mcContainer = document.getElementById("mcqs");
MC.forEach((item, i) => {
  const div = document.createElement("div");
  div.className = "quiz-q";
  const optsHtml = item.opts.map((o,j) =>
    `<button class="quiz-opt" data-q="${i}" data-j="${j}" onclick="pickMC(this,${item.a},${j})">${String.fromCharCode(65+j)}. ${o}</button>`
  ).join("");
  div.innerHTML = `<div class="quiz-qnum">Question ${i+1} of 10</div>
    <div class="quiz-qtext">${item.q}</div>
    <div class="quiz-opts">${optsHtml}</div>
    <div class="fib-hint" id="mch${i}"></div>`;
  mcContainer.appendChild(div);
});

function pickMC(el, correct, chosen) {
  const q = el.getAttribute("data-q");
  const parent = el.closest(".quiz-q");
  if (parent.querySelector(".correct,.wrong")) return;
  parent.querySelectorAll(".quiz-opt").forEach(b => b.style.pointerEvents="none");
  el.classList.add(chosen===correct ? "correct" : "wrong");
  if (chosen !== correct) {
    parent.querySelector(`[data-j="${correct}"]`).classList.add("correct");
  }
  const h = document.getElementById("mch"+q);
  h.style.color = chosen===correct ? "#1a5c2a" : "#c0392b";
  h.textContent = chosen===correct ? "✓ Correct!" : `✗ The correct answer is: ${MC[q].opts[correct]}`;
}

// Build Matching
const matchContainer = document.getElementById("matchqs");
const shuffledDefs = [...MATCH_DEFS];
MATCH_TERMS.forEach((term, i) => {
  const row = document.createElement("div");
  row.className = "quiz-q";
  const opts = shuffledDefs.map((d,j) => `<option value="${j}">${d.substring(0,60)}...</option>`).join("");
  row.innerHTML = `<div class="quiz-qnum">Term ${i+1}</div>
    <div class="quiz-qtext" style="font-weight:700;font-size:17px;">${term}</div>
    <select class="match-select" id="match${i}">
      <option value="">— Select the matching description —</option>
      ${opts}
    </select>
    <div class="fib-hint" id="matchh${i}"></div>`;
  matchContainer.appendChild(row);
});

// Score functions
function checkFIB() {
  const ans = ["bush v. gore","patriot","homeland","ipod","genome"];
  const hints = ["Bush v. Gore","PATRIOT","Homeland","iPod","Genome"];
  let score = 0;
  for (let i=1;i<=5;i++) {
    const inp = document.getElementById("fib"+i);
    const h = document.getElementById("fib"+i+"h");
    const val = inp.value.trim().toLowerCase();
    const correct = ans[i-1].split("|");
    const right = correct.some(c => val.includes(c.toLowerCase().split(" ")[0]) || c.toLowerCase().includes(val) && val.length > 2);
    inp.classList.remove("correct","wrong");
    inp.classList.add(right ? "correct" : "wrong");
    h.style.color = right ? "#1a5c2a" : "#c0392b";
    h.textContent = right ? "✓ Correct!" : `✗ The answer is: ${hints[i-1]}`;
    if(right) score++;
  }
  const sb = document.getElementById("fibScore");
  sb.style.display="inline-flex";
  sb.textContent = `${score}/5 correct`;
}

function checkTF() {
  let score = 0;
  TF.forEach((_,i) => {
    const parent = document.querySelectorAll("#tab1 .quiz-q")[i];
    if (parent.querySelector(".correct")) score++;
  });
  const sb = document.getElementById("tfScore");
  sb.style.display="inline-flex";
  sb.textContent = `${score}/10 answered correctly`;
}

function checkMC() {
  let score = 0;
  MC.forEach((_,i) => {
    const parent = document.querySelectorAll("#tab2 .quiz-q")[i];
    if (parent.querySelector(".correct")) score++;
  });
  const sb = document.getElementById("mcScore");
  sb.style.display="inline-flex";
  sb.textContent = `${score}/10 answered correctly`;
}

function checkMatch() {
  let score = 0;
  MATCH_TERMS.forEach((_, i) => {
    const sel = document.getElementById("match"+i);
    const h = document.getElementById("matchh"+i);
    sel.classList.remove("correct","wrong");
    const val = parseInt(sel.value);
    if (isNaN(val)) { h.textContent="Please select an answer."; h.style.color="#c0392b"; return; }
    const right = val === MATCH_ANS[i];
    sel.classList.add(right ? "correct" : "wrong");
    h.style.color = right ? "#1a5c2a" : "#c0392b";
    h.textContent = right ? "✓ Correct!" : `✗ Correct answer: ${MATCH_DEFS[MATCH_ANS[i]].substring(0,60)}...`;
    if(right) score++;
  });
  const sb = document.getElementById("matchScore");
  sb.style.display="inline-flex";
  sb.textContent = `${score}/5 correct`;
}

function updateWC() {
  const words = document.getElementById("essayText").value.trim().split(/\s+/).filter(w=>w).length;
  document.getElementById("wcDisplay").textContent = words + (words===1?" word":" words");
}
</script>
