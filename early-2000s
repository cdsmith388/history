<div class="qtxt">${q.q}</div>
<input class="fbi" id="fb${i}" placeholder="Your answer..." oninput="ckFB(${i})">
<div style="display:flex;align-items:center;gap:8px;margin-top:6px">
<button class="ckbtn" id="fbB${i}" onclick="subFB(${i})" disabled>Check</button>
<span style="font-size:10.5px;color:#bbb">Hint: ${q.h}</span>
</div>
<div class="ifb" id="fbR${i}"></div>
</div>`).join('');

  const tfH=TF.map((q,i)=>`
<div style="margin-bottom:13px">
<div class="qnum">Question ${i+1} of 10</div>
<div class="qtxt">${q.q}</div>
<div class="tfrow">
<button class="tfb" id="tfT${i}" onclick="subTF(${i},true)">True</button>
<button class="tfb" id="tfF${i}" onclick="subTF(${i},false)">False</button>
</div>
<div class="ifb" id="tfR${i}"></div>
</div>`).join('');

  const mcH=MC.map((q,i)=>`
<div style="margin-bottom:13px">
<div class="qnum">Question ${i+1} of 10</div>
<div class="qtxt">${q.q}</div>
${q.o.map((o,j)=>`<div class="mco" id="mc${i}_${j}" onclick="subMC(${i},${j})"><span class="mlet">${String.fromCharCode(65+j)}</span><span>${o}</span></div>`).join('')}
<div class="ifb" id="mcR${i}"></div>
