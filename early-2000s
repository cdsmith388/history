  const tH=MP.map((_,i)=>`<button class="mterm" id="mT${i}" onclick="selT(${i})">${MP[i].term}</button>`).join('');
  const dH=shMT.map((p,i)=>`<button class="mdef" id="mD${i}" onclick="selD(${shMap[i]},${i})">${p.def}</button>`).join('');

  return`
