     GLOSSARY MODAL
     ============================================ -->
<div class="glossary-modal" id="glossaryModal">
  <div class="glossary-card">
    <div class="glossary-head">
      <span>// DEFINITION.EXE</span>
      <button class="glossary-close" id="glossaryClose" aria-label="Close">✕</button>
    </div>
    <div class="glossary-body">
      <div class="glossary-term" id="glossaryTerm">Term</div>
      <div class="glossary-def" id="glossaryDef">Definition goes here.</div>
    </div>
  </div>
</div>

