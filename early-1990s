<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Early 1990s : After the Wall, Before the Web Took Over</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Monoton&family=Bungee&family=VT323&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
/* ============================================
   CSS RESET + ROOT
   ============================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Lora', Georgia, serif;
  background: #FFF8E7;
  color: #1A0033;
  line-height: 1.75;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

:root {
  --pink: #FF1F8F;
  --pink-hot: #FF006E;
  --cyan: #00E5FF;
  --cyan-deep: #00B8D4;
  --lime: #C6FF00;
  --lime-deep: #76FF03;
  --purple: #9D00FF;
  --purple-deep: #6200EA;
  --yellow: #FFD60A;
  --orange: #FF6F00;
  --cream: #FFF8E7;
  --paper: #FFFDF5;
  --ink: #1A0033;
  --black: #0A0A0A;
  --shadow: 6px 6px 0 var(--ink);
  --shadow-pink: 6px 6px 0 var(--pink);
  --shadow-cyan: 6px 6px 0 var(--cyan-deep);
}

/* ============================================
   PROGRESS BAR
   ============================================ */
.progress-bar {
  position: fixed;
  top: 0; left: 0;
  height: 6px;
  width: 0%;
  background: linear-gradient(90deg, var(--pink-hot), var(--cyan), var(--lime), var(--purple), var(--yellow));
  z-index: 1000;
  transition: width 0.1s linear;
  box-shadow: 0 2px 6px rgba(0,0,0,0.3);
}

/* ============================================
   CRT SCANLINE OVERLAY
   ============================================ */
.crt-overlay {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 999;
  background: repeating-linear-gradient(
    0deg,
    rgba(0,0,0,0.04) 0px,
    rgba(0,0,0,0.04) 1px,
    transparent 1px,
    transparent 3px
  );
  mix-blend-mode: multiply;
  opacity: 0.5;
}

/* ============================================
   MEMPHIS DECORATIVE SHAPES (BG)
   ============================================ */
.memphis {
  position: absolute;
  pointer-events: none;
  z-index: 0;
}
.memphis.zigzag {
  width: 80px; height: 30px;
  background: repeating-linear-gradient(135deg, var(--pink-hot) 0 8px, transparent 8px 16px);
}
.memphis.dots {
  width: 100px; height: 100px;
  background-image: radial-gradient(var(--ink) 2px, transparent 2px);
  background-size: 12px 12px;
}
.memphis.triangle {
  width: 0; height: 0;
  border-left: 30px solid transparent;
  border-right: 30px solid transparent;
  border-bottom: 50px solid var(--lime);
}
.memphis.squiggle {
  width: 120px; height: 40px;
  background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 40'><path d='M0 20 Q15 0 30 20 T60 20 T90 20 T120 20' stroke='%2300E5FF' stroke-width='5' fill='none'/></svg>");
}
.memphis.circle {
  width: 60px; height: 60px;
  border-radius: 50%;
  background: var(--yellow);
  border: 4px solid var(--ink);
}
.memphis.star {
  width: 50px; height: 50px;
  background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 50 50'><polygon points='25,2 31,18 48,18 34,28 40,46 25,36 10,46 16,28 2,18 19,18' fill='%23FF006E' stroke='%231A0033' stroke-width='2'/></svg>");
}

/* ============================================
   HERO SECTION
   ============================================ */
.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  background:
    radial-gradient(ellipse at top, #2D0066 0%, #0A0033 50%, #000010 100%);
  color: var(--cream);
  overflow: hidden;
  padding: 4rem 2rem;
}
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,31,143,0.15) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,229,255,0.15) 1px, transparent 1px);
  background-size: 60px 60px;
  background-position: center bottom;
  transform: perspective(500px) rotateX(60deg);
  transform-origin: center 100%;
  height: 50%;
  top: auto;
  bottom: 0;
  animation: gridMove 20s linear infinite;
}
@keyframes gridMove {
  0% { background-position: 0 0; }
  100% { background-position: 0 60px; }
}
.hero::after {
  content: '';
  position: absolute;
  width: 280px;
  height: 280px;
  border-radius: 50%;
  background: radial-gradient(circle, #FFD60A 0%, #FF6F00 40%, #FF006E 80%, transparent 100%);
  top: 18%;
  left: 50%;
  transform: translateX(-50%);
  filter: blur(2px);
  box-shadow: 0 0 80px rgba(255, 31, 143, 0.6);
  z-index: 1;
}
.hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 1000px;
}
.hero-tag {
  font-family: 'VT323', monospace;
  color: var(--cyan);
  font-size: 1.6rem;
  letter-spacing: 0.25em;
  margin-bottom: 1.5rem;
  text-shadow: 0 0 12px var(--cyan);
}
.hero-tag::before, .hero-tag::after {
  content: '▓▒░';
  margin: 0 0.8rem;
  color: var(--pink-hot);
}
.hero h1 {
  font-family: 'Monoton', cursive;
  font-size: clamp(3.5rem, 11vw, 8.5rem);
  line-height: 0.95;
  letter-spacing: 0.02em;
  margin-bottom: 1.5rem;
  background: linear-gradient(180deg, #FFD60A 0%, #FF006E 50%, #9D00FF 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 4px 4px 0 rgba(0,0,0,0.3);
  filter: drop-shadow(0 0 30px rgba(255, 31, 143, 0.5));
}
.hero-sub {
  font-family: 'Bungee', sans-serif;
  font-size: clamp(1rem, 2.5vw, 1.8rem);
  color: var(--cream);
  margin-bottom: 2.5rem;
  letter-spacing: 0.05em;
}
.hero-sub .accent { color: var(--lime); }
.hero-meta {
  font-family: 'VT323', monospace;
  color: var(--cream);
  font-size: 1.3rem;
  border: 2px dashed var(--cyan);
  display: inline-block;
  padding: 0.6rem 1.5rem;
  margin-bottom: 3rem;
  background: rgba(0, 0, 0, 0.3);
}
.scroll-cue {
  position: relative;
  z-index: 2;
  font-family: 'VT323', monospace;
  color: var(--cream);
  font-size: 1.3rem;
  letter-spacing: 0.2em;
  animation: bounce 1.6s ease-in-out infinite;
  margin-top: 2rem;
}
@keyframes bounce {
  0%, 100% { transform: translateY(0); opacity: 0.6; }
  50% { transform: translateY(10px); opacity: 1; }
}

/* Floating Memphis shapes in hero */
.hero .memphis { z-index: 2; }
.hero .m1 { top: 8%; left: 6%; transform: rotate(-15deg); }
.hero .m2 { top: 15%; right: 8%; transform: rotate(20deg); }
.hero .m3 { bottom: 12%; left: 10%; transform: rotate(45deg); }
.hero .m4 { bottom: 20%; right: 12%; transform: rotate(-30deg); }

/* ============================================
   SECTIONS & CONTENT
   ============================================ */
.section {
  padding: 5rem 2rem;
  position: relative;
  overflow: hidden;
}
.container {
  max-width: 880px;
  margin: 0 auto;
  position: relative;
  z-index: 2;
}
.section-num {
  font-family: 'Bungee', sans-serif;
  display: inline-block;
  background: var(--ink);
  color: var(--lime);
  padding: 0.4rem 1.2rem;
  font-size: 1rem;
  letter-spacing: 0.1em;
  margin-bottom: 1.5rem;
  transform: rotate(-2deg);
  box-shadow: 4px 4px 0 var(--pink-hot);
}
.section h2 {
  font-family: 'Bungee', sans-serif;
  font-size: clamp(2rem, 5vw, 3.6rem);
  line-height: 1.05;
  margin-bottom: 2.5rem;
  color: var(--ink);
  letter-spacing: -0.01em;
}
.section h2 .hi {
  background: var(--lime);
  padding: 0 0.3em;
  display: inline-block;
  transform: rotate(-1deg);
  box-shadow: 4px 4px 0 var(--ink);
}
.section h2 .hi-pink {
  background: var(--pink-hot);
  color: var(--cream);
  padding: 0 0.3em;
  display: inline-block;
  transform: rotate(1deg);
  box-shadow: 4px 4px 0 var(--ink);
}
.section h2 .hi-cyan {
  background: var(--cyan);
  padding: 0 0.3em;
  display: inline-block;
  transform: rotate(-1deg);
  box-shadow: 4px 4px 0 var(--ink);
}

.section p {
  font-size: 1.15rem;
  line-height: 1.85;
  margin-bottom: 1.6rem;
  color: var(--ink);
  max-width: 70ch;
}
.section p.drop::first-letter {
  font-family: 'Monoton', cursive;
  font-size: 4.5rem;
  float: left;
  line-height: 0.9;
  padding: 0.3rem 0.7rem 0 0;
  color: var(--pink-hot);
}

/* Clickable glossary terms */
.term {
  font-weight: 700;
  color: var(--purple-deep);
  background: linear-gradient(180deg, transparent 60%, var(--yellow) 60%, var(--yellow) 92%, transparent 92%);
  cursor: pointer;
  padding: 0 2px;
  transition: all 0.2s ease;
  position: relative;
  border: none;
  font-family: inherit;
  font-size: inherit;
  display: inline;
}
.term::after {
  content: '?';
  font-family: 'VT323', monospace;
  font-size: 0.8em;
  vertical-align: super;
  color: var(--pink-hot);
  margin-left: 2px;
  font-weight: normal;
}
.term:hover {
  background: var(--pink-hot);
  color: var(--cream);
  transform: translateY(-1px);
}
.term:hover::after {
  color: var(--cream);
}

/* ============================================
   SECTION BACKGROUNDS
   ============================================ */
.sec-1 { background: var(--cream); }
.sec-1::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(rgba(157,0,255,0.08) 2px, transparent 2px);
  background-size: 30px 30px;
  z-index: 1;
}

.sec-2 {
  background: linear-gradient(180deg, #1A0033 0%, #2D0066 100%);
  color: var(--cream);
}
.sec-2 h2, .sec-2 p { color: var(--cream); }
.sec-2 .section-num { background: var(--lime); color: var(--ink); box-shadow: 4px 4px 0 var(--cyan); }
.sec-2 .term { color: var(--lime); background: linear-gradient(180deg, transparent 60%, rgba(0,229,255,0.3) 60%, rgba(0,229,255,0.3) 92%, transparent 92%); }
.sec-2 .term:hover { background: var(--cyan); color: var(--ink); }
.sec-2::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0,229,255,0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,229,255,0.08) 1px, transparent 1px);
  background-size: 50px 50px;
  z-index: 1;
}

.sec-3 { background: #FFE5F1; }
.sec-3::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    repeating-linear-gradient(45deg, transparent 0 30px, rgba(157,0,255,0.05) 30px 31px),
    repeating-linear-gradient(-45deg, transparent 0 30px, rgba(255,0,110,0.05) 30px 31px);
  z-index: 1;
}

.sec-4 { background: var(--paper); }
.sec-4::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 60px;
  background: repeating-linear-gradient(90deg, var(--pink-hot) 0 40px, var(--cyan) 40px 80px, var(--lime) 80px 120px, var(--yellow) 120px 160px, var(--purple) 160px 200px);
  z-index: 1;
}
.sec-4 .container { padding-top: 2rem; }

.sec-5 {
  background: linear-gradient(180deg, #FFD60A 0%, #FF6F00 100%);
}
.sec-5::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(rgba(255,255,255,0.3) 3px, transparent 3px);
  background-size: 40px 40px;
  z-index: 1;
}

/* ============================================
   IMAGES & FIGURES
   ============================================ */
figure {
  margin: 3rem 0;
  position: relative;
}
figure.full {
  margin-left: calc(-1 * (50vw - 50%));
  margin-right: calc(-1 * (50vw - 50%));
  max-width: 100vw;
}
figure img {
  width: 100%;
  height: auto;
  display: block;
  border: 4px solid var(--ink);
  box-shadow: var(--shadow);
  transform: rotate(-1deg);
  transition: transform 0.4s ease;
}
figure.tilt-right img { transform: rotate(1.5deg); }
figure.tilt-left img { transform: rotate(-1.5deg); }
figure:hover img { transform: rotate(0deg) scale(1.01); }
figcaption {
  font-family: 'VT323', monospace;
  font-size: 1.15rem;
  margin-top: 1rem;
  color: var(--purple-deep);
  text-align: center;
  letter-spacing: 0.03em;
}
.sec-2 figcaption { color: var(--cyan); }
.sec-5 figcaption { color: var(--ink); font-weight: 600; }

.img-pair {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  margin: 3rem 0;
}
.img-pair figure { margin: 0; }
.img-pair figure:nth-child(1) img { transform: rotate(-2deg); }
.img-pair figure:nth-child(2) img { transform: rotate(2deg); }

@media (max-width: 700px) {
  .img-pair { grid-template-columns: 1fr; }
}

/* ============================================
   REFLECTION CARDS
   ============================================ */
.reflect {
  margin: 4rem 0;
  padding: 2.5rem;
  background: var(--cyan);
  border: 4px solid var(--ink);
  box-shadow: 10px 10px 0 var(--pink-hot);
  position: relative;
  transform: rotate(-0.5deg);
}
.reflect::before {
  content: 'PAUSE / REFLECT';
  position: absolute;
  top: -16px;
  left: 20px;
  font-family: 'Bungee', sans-serif;
  background: var(--ink);
  color: var(--lime);
  padding: 0.3rem 1rem;
  font-size: 0.95rem;
  letter-spacing: 0.1em;
}
.reflect h3 {
  font-family: 'Bungee', sans-serif;
  font-size: 1.5rem;
  margin-bottom: 1rem;
  color: var(--ink);
}
.reflect ul {
  list-style: none;
  padding: 0;
}
.reflect li {
  font-family: 'Lora', serif;
  font-size: 1.1rem;
  padding: 0.7rem 0 0.7rem 2.2rem;
  position: relative;
  color: var(--ink);
  line-height: 1.5;
}
.reflect li::before {
  content: '►';
  position: absolute;
  left: 0;
  color: var(--pink-hot);
  font-size: 1.1rem;
}

.retain {
  margin: 4rem 0;
  padding: 2rem 2.5rem;
  background: var(--lime);
  border: 4px solid var(--ink);
  box-shadow: 10px 10px 0 var(--purple);
  position: relative;
  transform: rotate(0.5deg);
}
.retain::before {
  content: 'QUICK RECAP';
  position: absolute;
  top: -16px;
  left: 20px;
  font-family: 'Bungee', sans-serif;
  background: var(--pink-hot);
  color: var(--cream);
  padding: 0.3rem 1rem;
  font-size: 0.95rem;
  letter-spacing: 0.1em;
}
.retain h3 {
  font-family: 'Bungee', sans-serif;
  font-size: 1.4rem;
  margin-bottom: 1rem;
  color: var(--ink);
}
.retain .keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin-top: 1.2rem;
}
.retain .kw {
  font-family: 'VT323', monospace;
  background: var(--ink);
  color: var(--cream);
  padding: 0.3rem 0.8rem;
  font-size: 1.1rem;
  letter-spacing: 0.05em;
}
.retain p { font-size: 1.05rem; color: var(--ink); margin-bottom: 0.6rem; }

/* ============================================
   YOUTUBE EMBED
   ============================================ */
.video-wrap {
  margin: 3.5rem 0;
  padding: 1.2rem;
  background: var(--ink);
  border: 4px solid var(--ink);
  box-shadow: var(--shadow-pink);
  transform: rotate(-0.8deg);
}
.video-wrap::before {
  content: '▶ ON YOUR TV / OCTOBER 1, 1992';
  font-family: 'VT323', monospace;
  color: var(--lime);
  font-size: 1.1rem;
  display: block;
  margin-bottom: 0.6rem;
  letter-spacing: 0.1em;
}
.video-frame {
  position: relative;
  padding-bottom: 56.25%;
  height: 0;
  background: #000;
  border: 2px solid var(--cyan);
}
.video-frame iframe {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  border: 0;
}

/* ============================================
   GLOSSARY MODAL
   ============================================ */
.glossary-modal {
  position: fixed;
  inset: 0;
  background: rgba(26, 0, 51, 0.85);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  padding: 2rem;
  backdrop-filter: blur(3px);
}
.glossary-modal.open { display: flex; animation: fadeIn 0.2s ease; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.glossary-card {
  background: var(--cream);
  border: 5px solid var(--ink);
  box-shadow: 12px 12px 0 var(--pink-hot);
  max-width: 540px;
  width: 100%;
  position: relative;
  animation: pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes pop {
  0% { transform: scale(0.7) rotate(-3deg); opacity: 0; }
  100% { transform: scale(1) rotate(0); opacity: 1; }
}
.glossary-head {
  background: var(--ink);
  color: var(--lime);
  padding: 0.6rem 1.2rem;
  font-family: 'VT323', monospace;
  font-size: 1.2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  letter-spacing: 0.05em;
}
.glossary-close {
  background: var(--pink-hot);
  color: var(--cream);
  border: 2px solid var(--cream);
  font-family: 'Bungee', sans-serif;
  width: 32px; height: 32px;
  cursor: pointer;
  font-size: 1rem;
  line-height: 1;
}
.glossary-body { padding: 2rem 2rem 2.2rem; }
.glossary-term {
  font-family: 'Bungee', sans-serif;
  font-size: 1.8rem;
  color: var(--purple-deep);
  margin-bottom: 0.8rem;
  line-height: 1.1;
}
.glossary-def {
  font-family: 'Lora', serif;
  font-size: 1.1rem;
  line-height: 1.65;
  color: var(--ink);
}

/* ============================================
   MARQUEE BANNERS
   ============================================ */
.marquee {
  background: var(--ink);
  color: var(--cream);
  padding: 1rem 0;
  overflow: hidden;
  white-space: nowrap;
  border-top: 4px solid var(--pink-hot);
  border-bottom: 4px solid var(--cyan);
  font-family: 'Bungee', sans-serif;
  letter-spacing: 0.1em;
  font-size: 1.3rem;
}
.marquee-track {
  display: inline-block;
  animation: marqueeMove 28s linear infinite;
}
.marquee-track span {
  display: inline-block;
  padding: 0 2rem;
}
.marquee-track .star { color: var(--yellow); }
.marquee-track .pink { color: var(--pink-hot); }
.marquee-track .cyan { color: var(--cyan); }
.marquee-track .lime { color: var(--lime); }
@keyframes marqueeMove {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* ============================================
   QUIZ SECTION
   ============================================ */
.quiz {
  background: var(--ink);
  color: var(--cream);
  padding: 6rem 2rem;
  position: relative;
}
.quiz::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    repeating-linear-gradient(0deg, transparent 0 40px, rgba(255,31,143,0.04) 40px 41px),
    repeating-linear-gradient(90deg, transparent 0 40px, rgba(0,229,255,0.04) 40px 41px);
}
.quiz .container { max-width: 920px; position: relative; z-index: 2; }
.quiz h2 {
  font-family: 'Monoton', cursive;
  font-size: clamp(3rem, 8vw, 5.5rem);
  text-align: center;
  margin-bottom: 0.5rem;
  background: linear-gradient(90deg, var(--pink-hot), var(--cyan), var(--lime), var(--yellow));
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 0 20px rgba(255,31,143,0.4));
}
.quiz .quiz-subtitle {
  text-align: center;
  font-family: 'VT323', monospace;
  color: var(--cyan);
  font-size: 1.4rem;
  letter-spacing: 0.15em;
  margin-bottom: 4rem;
}

.q-section {
  margin-bottom: 3.5rem;
  background: var(--cream);
  color: var(--ink);
  padding: 2rem 2.2rem;
  border: 4px solid var(--cream);
  box-shadow: 8px 8px 0 var(--pink-hot);
}
.q-section.cyan-shadow { box-shadow: 8px 8px 0 var(--cyan); }
.q-section.lime-shadow { box-shadow: 8px 8px 0 var(--lime); }
.q-section.purple-shadow { box-shadow: 8px 8px 0 var(--purple); }
.q-section.yellow-shadow { box-shadow: 8px 8px 0 var(--yellow); }

.q-head {
  font-family: 'Bungee', sans-serif;
  font-size: 1.5rem;
  color: var(--ink);
  margin-bottom: 0.4rem;
  display: flex;
  align-items: center;
  gap: 0.8rem;
}
.q-head .badge {
  background: var(--ink);
  color: var(--lime);
  padding: 0.2rem 0.7rem;
  font-size: 0.85rem;
