<!-- ============================================
     JAVASCRIPT
     ============================================ -->
<script>
// ============================================
// GLOSSARY DATA
// ============================================
const GLOSSARY = {
  berlin_wall: {
    term: "Berlin Wall",
    def: "The concrete barrier built in 1961 that divided communist East Berlin from West Berlin. Standing as a physical symbol of the Cold War for nearly three decades, it fell in November 1989, opening the door to German reunification."
  },
  reunification: {
    term: "Reunification",
    def: "The process of bringing East and West Germany back together into one country. It was formally completed on October 3, 1990, now celebrated as the Day of German Unity."
  },
  soviet_union: {
    term: "Soviet Union",
    def: "A communist superpower made up of multiple republics and ruled from Moscow, formally known as the USSR. It rivaled the United States throughout the Cold War and dissolved into independent nations in December 1991."
  },
  cold_war: {
    term: "Cold War",
    def: "The decades-long political, military, and ideological conflict between the United States and the Soviet Union (and their allies) after World War II. It ended in the early 1990s with the collapse of the Soviet Union, not with a direct war between the two superpowers."
  },
  superpower: {
    term: "Superpower",
    def: "A nation with overwhelming political, military, and economic influence on a global scale. After 1991, the United States stood as the world's only remaining superpower."
  },
  gorbachev: {
    term: "Mikhail Gorbachev",
    def: "The Soviet leader (General Secretary) whose reform policies of glasnost (openness) and perestroika (restructuring) loosened controls on Soviet society. After surviving a failed 1991 hard-line coup, his weakened position helped seal the fate of the Soviet Union."
  },
  yeltsin: {
    term: "Boris Yeltsin",
    def: "Russian political leader who rose to prominence by defying the 1991 coup against Gorbachev. He became the first president of the independent Russian Federation after the Soviet Union dissolved."
  },
  www: {
    term: "World Wide Web",
    def: "A system that uses websites, web pages, browsers, and hyperlinks to help people navigate information across the internet. Invented by Tim Berners-Lee at CERN in 1989, with software released publicly in 1991."
  },
  berners_lee: {
    term: "Tim Berners-Lee",
    def: "British computer scientist who invented the World Wide Web while working at CERN in 1989. He wrote the first web browser, web server, and the foundational protocols (HTTP, HTML) that still power the Web."
  },
  cern: {
    term: "CERN",
    def: "The European Organization for Nuclear Research, a major physics laboratory near Geneva, Switzerland. It was the workplace where Tim Berners-Lee invented the World Wide Web to help scientists share information."
  },
  internet: {
    term: "Internet",
    def: "The larger global network of connected computers that the World Wide Web runs on top of. Think of the internet as the roads and wires; the Web is just one of the services that uses those roads."
  },
  hyperlink: {
    term: "Hyperlink",
    def: "A clickable link that takes a user from one place on the Web to another. Hyperlinks are the foundational idea of the Web, turning information into a network instead of a stack."
  },
  nafta: {
    term: "NAFTA",
    def: "The North American Free Trade Agreement, signed in 1992 and in effect from 1994 to 2020. It gradually eliminated most tariffs and trade barriers among the United States, Canada, and Mexico."
  },
  globalization: {
    term: "Globalization",
    def: "The growing connection of economies, companies, workers, goods, and markets across national borders. In the 1990s it became one of the central debates in American politics."
  },
  tariffs: {
    term: "Tariffs",
    def: "Taxes placed on imported goods. Trade agreements like NAFTA aimed to reduce or eliminate tariffs to encourage more cross-border trade."
  },
  clinton: {
    term: "Bill Clinton",
    def: "Democratic governor of Arkansas who became the 42nd president of the United States. He won the 1992 election with 43 percent of the popular vote in a three-way race and was re-elected in 1996."
  },
  electoral_college: {
    term: "Electoral College",
    def: "The system by which the United States formally elects its president. State electors cast votes based on each state's results. A candidate can win a strong Electoral College victory even without winning a majority of the national popular vote."
  },
  recession: {
    term: "Recession",
    def: "A period of significant economic decline lasting several months or more. The early 1990s recession was one of the issues Clinton emphasized in his 1992 campaign."
  },
  perot: {
    term: "Ross Perot",
    def: "Texas businessman who ran as an independent presidential candidate in 1992 and as the Reform Party candidate in 1996. He won no electoral votes but drew significant popular support."
  },
  dole: {
    term: "Bob Dole",
    def: "Veteran Republican senator from Kansas and the Republican presidential nominee in 1996. He lost to Bill Clinton, 379 to 159 in the Electoral College."
  },
  cartoon_network: {
    term: "Cartoon Network",
    def: "A cable television channel that launched on October 1, 1992. It grew out of Turner Broadcasting's library of classic animation and Hanna-Barbera material, making cartoons feel like a full-time TV universe."
  },
  beanie_babies: {
    term: "Beanie Babies",
    def: "Small bean-filled stuffed animals introduced by Ty Inc. in 1993. Limited releases, retirements, and tag variations turned them into a national collector craze, where people speculated on them like a market."
  },
  amazon: {
    term: "Amazon",
    def: "The company founded by Jeff Bezos on July 5, 1994. It began as an online bookstore and demonstrated that the Web could be a marketplace, not just a library."
  },
  bezos: {
    term: "Jeff Bezos",
    def: "Founder of Amazon. In 1994 he started the company in a small office, selling only books, before it grew into one of the world's largest retailers."
  },
  toy_story: {
    term: "Toy Story",
    def: "Released November 22, 1995, by Pixar. The world's first fully computer-generated animated feature film, it permanently changed the animation industry."
  },
  pixar: {
    term: "Pixar",
    def: "The animation studio that produced Toy Story and pioneered computer-generated feature animation. It later became part of The Walt Disney Company."
  }
};

// ============================================
// GLOSSARY MODAL
// ============================================
const modal = document.getElementById('glossaryModal');
const termEl = document.getElementById('glossaryTerm');
const defEl = document.getElementById('glossaryDef');

function openGlossary(key) {
  const entry = GLOSSARY[key];
  if (!entry) return;
  termEl.textContent = entry.term;
  defEl.textContent = entry.def;
  modal.classList.add('open');
}
function closeGlossary() {
  modal.classList.remove('open');
}

document.querySelectorAll('.term').forEach(t => {
  t.addEventListener('click', (e) => {
    e.preventDefault();
    openGlossary(t.dataset.key);
  });
});
document.getElementById('glossaryClose').addEventListener('click', closeGlossary);
modal.addEventListener('click', (e) => { if (e.target === modal) closeGlossary(); });
document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeGlossary(); });

// ============================================
// PROGRESS BAR
// ============================================
const progressBar = document.getElementById('progressBar');
function updateProgress() {
  const h = document.documentElement;
  const scrolled = h.scrollTop;
  const total = h.scrollHeight - h.clientHeight;
  const pct = Math.min(100, (scrolled / total) * 100);
  progressBar.style.width = pct + '%';
}
window.addEventListener('scroll', updateProgress, { passive: true });
updateProgress();

// ============================================
// SCROLL REVEAL
// ============================================
const reveals = document.querySelectorAll('.reveal');
const io = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('in');
      io.unobserve(entry.target);
    }
  });
}, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
reveals.forEach(r => io.observe(r));

// ============================================
// QUIZ : T/F LABEL HIGHLIGHTING
// ============================================
document.querySelectorAll('.q-tf').forEach(group => {
  const labels = group.querySelectorAll('label');
  labels.forEach(label => {
    label.addEventListener('click', () => {
      labels.forEach(l => l.classList.remove('selected'));
      label.classList.add('selected');
    });
  });
});

// MC option highlight
document.querySelectorAll('.q-options').forEach(group => {
  const labels = group.querySelectorAll('label');
  labels.forEach(label => {
    label.addEventListener('click', () => {
      labels.forEach(l => l.classList.remove('selected'));
      label.classList.add('selected');
    });
  });
});

// ============================================
// ESSAY WORD COUNT
// ============================================
const essayBox = document.getElementById('essayBox');
const wcLabel = document.getElementById('wordCount');
essayBox.addEventListener('input', () => {
  const t = essayBox.value.trim();
  const n = t.length ? t.split(/\s+/).filter(Boolean).length : 0;
  wcLabel.textContent = 'words: ' + n;
});

// ============================================
// QUIZ GRADING
// ============================================
function normalize(s) {
  return (s || '').toLowerCase().trim().replace(/[.,!?;:]/g,'').replace(/\s+/g,' ');
}

function gradeQuiz() {
  const breakdown = [];
  let earned = 0;
  let total = 0;

  // Clear any prior tags
  document.querySelectorAll('.answer-tag').forEach(el => el.remove());
  document.querySelectorAll('.q-section').forEach(s => s.classList.add('graded'));
  document.querySelectorAll('.q-item').forEach(i => i.classList.remove('correct', 'incorrect'));
  document.querySelectorAll('.q-blank, .q-match select').forEach(i => { i.classList.remove('correct', 'incorrect'); });

  // ---- Part A: Fill in the blanks (5 pts) ----
  let aCorrect = 0;
  document.querySelectorAll('.q-blank').forEach(input => {
    const expected = normalize(input.closest('.q-item').dataset.answer);
    const actual = normalize(input.value);
    total++;
    const item = input.closest('.q-item');
    if (expected && actual === expected) {
      earned++; aCorrect++;
      input.style.borderColor = 'var(--lime-deep)';
      input.style.background = 'rgba(118,255,3,0.25)';
    } else {
      input.style.borderColor = 'var(--pink-hot)';
      input.style.background = 'rgba(255,0,110,0.12)';
      const tag = document.createElement('span');
      tag.className = 'answer-tag miss';
      tag.textContent = 'answer: ' + input.closest('.q-item').dataset.answer;
      input.insertAdjacentElement('afterend', tag);
    }
  });
  breakdown.push({label: 'A. Fill in the Blank', score: aCorrect, max: 5});

  // ---- Part B: True/False (10 pts) ----
  let bCorrect = 0;
  ['t1','t2','t3','t4','t5','t6','t7','t8','t9','t10'].forEach(name => {
    const item = document.querySelector(`.q-item[data-q="${name}"]`);
    if (!item) return;
    total++;
    const expected = item.dataset.answer;
    const checked = item.querySelector(`input[name="${name}"]:checked`);
    const actual = checked ? checked.value : null;
    if (actual === expected) {
      earned++; bCorrect++;
      item.classList.add('correct');
    } else {
      item.classList.add('incorrect');
      const tag = document.createElement('span');
      tag.className = 'answer-tag miss';
      tag.textContent = 'answer: ' + (expected === 'T' ? 'TRUE' : 'FALSE');
      item.querySelector('.q-text').appendChild(tag);
    }
  });
  breakdown.push({label: 'B. True / False', score: bCorrect, max: 10});

  // ---- Part C: Multiple Choice (10 pts) ----
  let cCorrect = 0;
  ['m1','m2','m3','m4','m5','m6','m7','m8','m9','m10'].forEach(name => {
    const item = document.querySelector(`.q-item[data-q="${name}"]`);
    if (!item) return;
    total++;
    const expected = item.dataset.answer;
    const checked = item.querySelector(`input[name="${name}"]:checked`);
    const actual = checked ? checked.value : null;
    if (actual === expected) {
      earned++; cCorrect++;
      item.classList.add('correct');
    } else {
      item.classList.add('incorrect');
      const tag = document.createElement('span');
      tag.className = 'answer-tag miss';
      tag.textContent = 'answer: ' + expected.toUpperCase();
      item.querySelector('.q-text').appendChild(tag);
    }
  });
  breakdown.push({label: 'C. Multiple Choice', score: cCorrect, max: 10});

  // ---- Part D: Matching (7 pts) ----
  let dCorrect = 0;
  document.querySelectorAll('.q-match select').forEach(sel => {
    total++;
    const expected = sel.dataset.answer;
    if (sel.value === expected) {
      earned++; dCorrect++;
      sel.style.borderColor = 'var(--lime-deep)';
      sel.style.background = 'rgba(118,255,3,0.25)';
    } else {
      sel.style.borderColor = 'var(--pink-hot)';
      sel.style.background = 'rgba(255,0,110,0.12)';
      const tag = document.createElement('span');
      tag.className = 'answer-tag miss';
      tag.textContent = '→ ' + expected;
      sel.insertAdjacentElement('afterend', tag);
    }
  });
  breakdown.push({label: 'D. Matching', score: dCorrect, max: 7});

  // ---- Render summary ----
  document.getElementById('scoreBig').textContent = earned + ' / ' + total;
  const pct = total ? Math.round((earned/total)*100) : 0;
  let label = 'AUTO-GRADED PARTS A-D';
  if (pct >= 90) label = '▓▒░ A+ MASTERY ░▒▓';
  else if (pct >= 80) label = '▓▒░ STRONG WORK ░▒▓';
  else if (pct >= 70) label = '▓▒░ GOOD EFFORT ░▒▓';
  else if (pct >= 60) label = '▓▒░ KEEP STUDYING ░▒▓';
  else label = '▓▒░ TIME TO REVIEW ░▒▓';
  document.getElementById('scoreLabel').textContent = label + ' / ' + pct + '%';

  const brk = document.getElementById('scoreBreakdown');
  brk.innerHTML = '';
  breakdown.forEach(b => {
    const row = document.createElement('div');
    row.className = 'br-row';
    const cls = (b.score === b.max) ? 'good' : (b.score >= b.max/2 ? '' : 'bad');
    row.innerHTML = `<span>${b.label}</span><span class="pts ${cls}">${b.score} / ${b.max}</span>`;
    brk.appendChild(row);
  });

  // Essay note
  const essayRow = document.createElement('div');
  essayRow.className = 'br-row';
  const ess = essayBox.value.trim();
  const ewc = ess.length ? ess.split(/\s+/).filter(Boolean).length : 0;
  essayRow.innerHTML = `<span>E. Essay (teacher graded)</span><span class="pts" style="color: var(--purple-deep);">${ewc} words</span>`;
  brk.appendChild(essayRow);

  document.getElementById('quizResult').classList.add('show');
  document.getElementById('quizResult').scrollIntoView({ behavior: 'smooth', block: 'center' });
}

document.getElementById('submitQuiz').addEventListener('click', gradeQuiz);

</script>
