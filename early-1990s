    <div class="q-submit-wrap reveal">
      <button class="q-submit" id="submitQuiz">▓▒ GRADE MY QUIZ ▒▓</button>
    </div>

    <div class="q-result" id="quizResult">
      <h3>Your Score</h3>
      <div class="score-big" id="scoreBig">0 / 32</div>
      <div class="score-label" id="scoreLabel">▓▒░ AUTO-GRADED PARTS A-D ░▒▓</div>
      <div class="breakdown" id="scoreBreakdown"></div>
      <p style="font-family: 'VT323', monospace; font-size: 1.3rem; color: var(--purple-deep); margin-top: 1.5rem; letter-spacing: 0.05em;">Scroll up to see which answers were correct and which need review.</p>
    </div>
  </div>
</section>

